#
#    Rate.InstanceResetTime
# 描述: 全局团队/英雄副本重置间隔的倍率
# (dbc 值)。值越大,重置间隔越长,
# 值越小时间越短,需要在
# characters 数据库,新值才能生效。
# 默认:     1

Rate.InstanceResetTime = 1

#
#    Instance.UnloadDelay
# 描述: 副本地图内没有玩家时从内存卸载的毫秒数,
# 角色所在。
# 默认:     1800000 - (启用,30 分钟)
# 0       - (禁用,副本地图保留在内存中,直到该副本
# 重置))

Instance.UnloadDelay = 1800000

#
#   AccountInstancesPerHour
# 描述: 控制玩家每小时可进入的不同副本数量上限
# 默认:     5

AccountInstancesPerHour = 5

#
#    Instance.SharedNormalHeroicId
# 描述: 强制 ICC 与 RS 的普通/英雄共享进度。TOC 不受影响,普通与英雄分开。
# 默认:     1 - 启用
# 0 - 禁用

Instance.SharedNormalHeroicId = 1

#
#    DungeonAccessRequirements.PrintMode
#
# 描述: 选择向未满足进入条件而无法进入副本传送门的玩家展示信息的格式:
# 默认:     1 - (一次只显示一条要求(官方设定,同 LFG 界面))
# 0 - (不显示额外信息,仅显示"条件不满足")
# 2 - (显示详细要求,一次性全部显示,带可点击链接)

DungeonAccessRequirements.PrintMode = 1

#
#    DungeonAccessRequirements.PortalAvgIlevelCheck
#
# 描述: 进入副本/团队传送门时启用平均装备等级要求(= 平均装等过低时拒绝进入,如同 LFG)。
# 默认:     0 - (禁用  -> 官方设定)
# 1 - (启用)

DungeonAccessRequirements.PortalAvgIlevelCheck = 0

#
#    DungeonAccessRequirements.OptionalStringID
#
# 描述: 打印副本进入条件后,在聊天中额外显示一条来自 acore_strings 的消息。
# 启用时,请从 acore_strings 表中设置所需文本的 ID
# 默认:     0  - (禁用)
# 1+ - (启用)

DungeonAccessRequirements.OptionalStringID = 0

#
###################################################################################################

###################################################################################################
# 游戏时长限制(CAIS)
#
#    CAIS.Enable
# 描述: 启用中国服务器的连续游戏时长限制。连续游戏 3
# 小时连续游戏后,经验与拾取金钱减半;5
# 小时后,角色将无法再获得经验、拾取或交任务。
# 离线 5 小时会重置累计时间。3 小时/5 小时
# 阈值由客户端硬编码。
# 注意:        重启 worldserver 会重置所有账号的累计时间。
# 默认:     0 - 禁用
# 1 - 启用

CAIS.Enable = 0

#
###################################################################################################

###################################################################################################
# 地下城与战场查找器(DUNGEON & BG FINDER)
#
#    JoinBGAndLFG.Enable
# 描述: 允许同时排队战场与地下城查找器。
# 默认:     0 - 禁用
# 1 - 启用

JoinBGAndLFG.Enable = 0

#
#    LFG.MailItemOnFullInventory
# 描述: 玩家队伍掷骰获胜但背包已满时,将
# 物品交给他们,而不是留在尸体上。
# 默认:     0 - 禁用
# 1 - 仅 LFG/RDF 队伍
# 2 - 所有队伍类型

LFG.MailItemOnFullInventory = 0

#
#    DungeonFinder.OptionsMask
# 描述: 地下城与团队查找器系统。
# 此值是位掩码,由以下部分组成:
# LFG_OPTION_ENABLE_DUNGEON_FINDER  = 1, 启用地下城查找器
# LFG_OPTION_ENABLE_RAID_BROWSER    = 2, 启用团队副本浏览器
# LFG_OPTION_ENABLE_SEASONAL_BOSSES = 4, 启用季节性 Boss
# 默认:     5

DungeonFinder.OptionsMask = 5

#
#    LFG.Location.All
#
# 描述: 包含卫星进程,以便在其他 LFG 上寻找工作
# 默认:     0 - 禁用
# 1 - 启用

LFG.Location.All = 0

#
#    LFG.MaxKickCount
# 描述: 指定 LFG 队伍允许的最大踢人次数(最多 3 次)
# 默认:     2
# 0 - 禁用(永不允许踢人)

LFG.MaxKickCount = 2

#
#    LFG.KickPreventionTimer
# 描述: 指定玩家刚加入 LFG 队伍后免于被踢的时长
# 默认:     900 秒 (15 分钟)
# 0 - 禁用

LFG.KickPreventionTimer = 900

#
#    DungeonAccessRequirements.LFGLevelDBCOverride
#
# 描述: 启用后,使用 `dungeon_access_requirements` 表的 `min_level`/`max_level` 决定地下城在 LFG 界面中显示还是隐藏。
# 默认:     0 - (禁用)
# 1 - (启用)

DungeonAccessRequirements.LFGLevelDBCOverride = 0

#
#    DungeonFinder.CastDeserter
#
# 描述: 对提前离开地下城的玩家施放逃亡者减益
# 默认:     1 - (启用,官方设定)
# 0 - (禁用)

DungeonFinder.CastDeserter = 1

#
#    DungeonFinder.AllowCompleted
#
# 描述: 控制是否将当天已完成的英雄地下城排除出 LFG 队列。
# 0 - (经典 WLK 模式: 当天任意队友已完成过的地下城将被排除(强制每日锁定))
# 默认:     1 - (官方设定: 所有地下城均可排队,即使当天已完成)

DungeonFinder.AllowCompleted = 1

#
#    DungeonFinder.DungeonSelectionCooldown
#
# 描述: 地下城选择冷却时长(分钟)。完成了
# 随机地下城的玩家在此
# 时长。这会降低连续排到同一地下城的概率。
# 默认:     0 - (禁用)

DungeonFinder.DungeonSelectionCooldown = 0

#
###################################################################################################

###################################################################################################
# 公会契约(CHARTER)
#
#    MinCharterName
# 描述: 契约名称的最小长度。
# 范围:       1-24
# 默认:     2

MinCharterName = 2

#
#    StrictCharterNames
# 描述: 限制公会/竞技场战队契约名称只能使用对应语言的字符集。
# 使用不允许的符号时禁止创建公会契约。
# 默认:     0 - (禁用,有限的按时区客户端检查)
# 1 - (启用,严格基础拉丁字符)
# 2 - (启用,严格按服务器区域字符,见 RealmZone 设置,
# 注意:        客户端需安装支持
# 该字符集。非官方本地化需要自定义字体,
# 需放在 clientdir/Fonts。
# 3 - (启用,基础拉丁字符 + 服务器时区字符)

StrictCharterNames = 0

#
###################################################################################################

###################################################################################################
# 公会(GUILD)
#
#    Guild.EventLogRecordsCount
# 描述: 每个公会存储的公会事件日志条数。旧条目
# 若日志条数超过设定值将被覆盖。
# 较大的数值可以避免此行为,但可能影响性能。
# 默认:     100

Guild.EventLogRecordsCount = 100

#
#    Guild.ResetHour
# 描述: 每日上限重置的时刻。
# 范围:       0-23
# 默认:     6 - (早上 6 点)

Guild.ResetHour = 6

#
#    Guild.BankEventLogRecordsCount
# 描述: 每个公会存储的公会银行事件日志条数。旧的
# 若日志条数超过
# 配置值。较大的数值可避免此行为,但可能影响性能
#                     impacts.
# 默认:     25 - (最小值)

Guild.BankEventLogRecordsCount = 25

#
#    MinPetitionSigns
# 描述: 创建公会所需契约签名数量。
# 范围:       0-9
# 默认:     9

MinPetitionSigns = 9

#
#    Guild.CharterCost
# 描述: 公会契约的费用(铜币)。
# 默认:     1000 - (10 银币)

Guild.CharterCost = 1000

#
#    Guild.AllowMultipleGuildMaster
# 描述: 允许多位会长。额外的会长必须通过
# ".guild rank" 命令。
# 默认:     0 - (禁用)
# 1 - (启用)

Guild.AllowMultipleGuildMaster = 0

#
#    Guild.BankInitialTabs
# 描述: 修改公会创建时公会银行可用的标签页数量
# 默认:     0   (不免费赠送标签页)
# 1-6 (创建公会时公会银行标签页数量)

Guild.BankInitialTabs = 0

#
# Guild.BankTabCost0-5
# 描述: 修改公会银行标签页价格。注意客户端仍会显示默认价格。
# 默认:     1000000  - (100 金币)
# 2500000  - (250 金币)
# 5000000  - (500 金币)
# 10000000 - (1000 金币)
# 25000000 - (2500 金币)
# 50000000 - (5000 金币)

Guild.BankTabCost0 = 1000000
Guild.BankTabCost1 = 2500000
Guild.BankTabCost2 = 5000000
Guild.BankTabCost3 = 10000000
Guild.BankTabCost4 = 25000000
Guild.BankTabCost5 = 50000000

#
#    Guild.MemberLimit
# 描述: 成员数达到或超过上限时,不允许再邀请新玩家入会。
# 默认:     0 - 禁用

Guild.MemberLimit = 0

#
###################################################################################################

###################################################################################################
# 自由 PVP(FFAPVP)
#
#    FFAPvPTimer
# 描述: 指定玩家离开自由 PVP 区域后取消 FFAPvP 标记的延迟。(如古拉巴什竞技场)
# 默认:     30 秒

FFAPvPTimer = 30

#
###################################################################################################

###################################################################################################
# 野外 PVP(OUTDOORPVP)
#
#    OutdoorPvPCaptureRate
# 描述: 指定野外 PVP 占点的速度倍率。(如东瘟疫之地、地狱火半岛)
# 默认:     1.0

OutdoorPvPCaptureRate = 1.0

#
###################################################################################################

###################################################################################################
# 冬拥湖(WINTERGRASP)
#
#    Wintergrasp.Enable
# 描述: 启用冬拥湖战场。
# 默认:     1 - (启用,实验性功能,仍在开发中)
# 0 - (战场禁用,冬拥湖世界处理仍会执行)
# 2 - (禁用冬拥湖全部处理)

Wintergrasp.Enable = 1

#
#    Wintergrasp.PlayerMax
# 描述: 冬拥湖每队允许的最大玩家数。
# 默认:     120

Wintergrasp.PlayerMax = 120

#
#    Wintergrasp.PlayerMin
# 描述: 冬拥湖每队所需的最少玩家数。
# 默认:     0

Wintergrasp.PlayerMin = 0

#
#    Wintergrasp.PlayerMinLvl
# 描述: 参加冬拥湖战斗所需的角色等级。
# 默认:     75

Wintergrasp.PlayerMinLvl = 75

#
#    Wintergrasp.BattleTimer
# 描述: 冬拥湖战斗持续时长(分钟)。
# 默认:     30

Wintergrasp.BattleTimer = 30

#
#    Wintergrasp.NoBattleTimer
# 描述: 冬拥湖战斗之间的间隔(分钟)。
# 默认:     150

Wintergrasp.NoBattleTimer = 150

#
#    Wintergrasp.CrashRestartTimer
# 描述: 若世界服务器在战斗进行中崩溃,
# 在战斗进行中崩溃。
# 默认:     10

Wintergrasp.CrashRestartTimer = 10

#
#     Wintergrasp.SkipBattleSessionCount
# 描述: 和平计时器到期时,若活跃会话数
# 超过此值,将不会开始新的战斗。
# 设为 0 可禁用此检查。
# 默认:     3500

Wintergrasp.SkipBattleSessionCount = 3500

#
#     Wintergrasp.KickVoAPlayers
# 描述: 将玩家踢出阿尔卡冯宝库并冻结其首领
# 在冬拥湖战斗开始前的几分钟内,
# 战时/10 分钟备战期间阻止新入场。
# 需要重启服务器才能生效(不支持 reload)。
# 默认:     1 - (启用,先警告玩家再传送回其
# 战斗开始前送回炉石绑定地)
# 0 - (禁用,玩家留在场内,Boss 行为
# 在冬拥湖期间仍正常运行)

Wintergrasp.KickVoAPlayers = 1

#
#     Wintergrasp.EssenceBothFactions
# 描述: 向两个阵营发放"冬拥湖精华"增益
# 和平期间(无论谁占据要塞)都会生效。
# 战时抑制仍然生效;此选项只影响
# 战斗结束后由谁获得增益。
# 默认:     0 - (禁用,仅防守方获得增益)
# 1 - (启用,进攻方与防守方均获得增益,
# 使双方阵营都能进入阿尔卡冯宝库)

Wintergrasp.EssenceBothFactions = 0

#
#     Wintergrasp.DeferShutdownTimer
# 描述: 若冬拥湖战斗
# 在倒计时结束时仍在进行中。它将被重新调度
# 为战斗剩余时间加上这么多分钟的缓冲。
# 空闲关机不受影响。
# 默认:     0 - (禁用)
# N - (启用,推迟到战斗剩余时间 + N 分钟)

Wintergrasp.DeferShutdownTimer = 0

#
###################################################################################################

###################################################################################################
# 战场(BATTLEGROUND)
#
#    Battleground.PrepTime
# 描述: 战场准备阶段的秒数。远古海滩将
# 是例外,因其船只时刻机制,始终使用默认 120 秒计时。
# 默认:     120

Battleground.PrepTime = 120

#
#    Battleground.CastDeserter
# 描述: 对中途退出战场的玩家施放逃亡者减益。
# 默认:     1 - (启用)
# 0 - (禁用)

Battleground.CastDeserter = 1

#
#    Battleground.QueueAnnouncer.Enable
# 描述: 在聊天中公告战场排队状态。
# 默认:     0 - (禁用)
# 1 - (启用)

Battleground.QueueAnnouncer.Enable = 0

#
#    Battleground.QueueAnnouncer.Limit.MinLevel
# 描述: 从指定等级起才启用排队公告。
# 受限时,仅当排队人数至少为 MinPlayers 才公告(见下方)
# 80 级时仅限制评级战场,低等级时仅限制战歌峡谷。
# 默认:     0  - (禁用,无限制)
# 10 - (对所有等级启用,因为战场 10 级开放)
# 20 - (20 级及以上启用)
# 80 - (仅 80 级启用)

Battleground.QueueAnnouncer.Limit.MinLevel = 0

#
#    Battleground.QueueAnnouncer.Limit.MinPlayers
# 描述: 当战场排队公告的等级限制启用(非 0)时,
# 仅当排队人数至少为 MinPlayers 时才显示。
# 默认:     3 - (3 人及以上排队时才显示)

Battleground.QueueAnnouncer.Limit.MinPlayers = 3

#
#    Battleground.QueueAnnouncer.SpamProtection.Delay
# 描述: 玩家在指定秒后重新排队时显示公告
# 默认:     30

Battleground.QueueAnnouncer.SpamProtection.Delay = 30

#
#    Battleground.QueueAnnouncer.PlayerOnly
# 描述: 战场排队公告类型。
# 默认:     0 - (系统消息,所有人可见)
# 1 - (私密,仅排队玩家可见)

Battleground.QueueAnnouncer.PlayerOnly = 0

#
#    Battleground.QueueAnnouncer.Timed
# 描述: 按计时器启用战场排队公告
# 默认:     0 - (禁用)
# 1 - (启用 - 设置 Arena.QueueAnnouncer.Timer)

Battleground.QueueAnnouncer.Timed = 0

#
#    Battleground.QueueAnnouncer.Timer
# 描述: 设置排队公告的计时器
# 默认:     30000 (30 秒)

Battleground.QueueAnnouncer.Timer = 30000

#
#    Battleground.PrematureFinishTimer
# 描述: 若战场因某队人数不足而提前结束的毫秒数,
# 某队人数不足。(数值在战场模板中定义)
# 默认:     300000 - (启用,5 分钟)
# 0      - (禁用,不推荐)

Battleground.PrematureFinishTimer = 300000

#
#    Battleground.PremadeGroupWaitForMatch
# 描述: 预组队伍等待匹配
# 另一阵营。
# 默认:     1800000 - (启用,30 分钟)
# 0       - (禁用,不推荐)

Battleground.PremadeGroupWaitForMatch = 1800000

#
#    Battleground.GiveXPForKills
# 描述: 战场荣誉击杀给予经验。
# 默认:     0 - (禁用)
# 1 - (启用)

Battleground.GiveXPForKills = 0

#
#    Battleground.Random.ResetHour
# 描述: 全局副本重置的时刻。
# 范围:       0-23
# 默认:     6 - (早上 6 点)

Battleground.Random.ResetHour = 6

#    Battleground.StoreStatistics.Enable
# 描述: 将战场分数存入数据库。
# 默认:     0 - (禁用)
# 1 - (启用)

Battleground.StoreStatistics.Enable = 0

#    Battleground.TrackDeserters.Enable
# 描述: 追踪战场逃兵。
# 默认:     0 - (禁用)
# 1 - (启用)

Battleground.TrackDeserters.Enable = 0

#
#    Battleground.InvitationType
# 描述: 设置战场邀请类型。
# 默认:     0 - (普通,所有排队玩家都受邀进入战场,
# 无需关心阵营平衡)
# 1 - (实验性,不允许邀请过多玩家
# 属于同一阵营时)
# 2 - (实验性,尽量使双方队伍均衡)

Battleground.InvitationType = 0

#
#    Battleground.ReportAFK.Timer
# 描述: 战斗开始几分钟后即可举报该玩家。
# 默认:     4

Battleground.ReportAFK.Timer = 4

#
#    Battleground.ReportAFK
# 描述: 将战场挂机玩家踢出所需的举报次数。
# 范围:       1-9
# 默认:     3

Battleground.ReportAFK = 3

#    Battleground.DisableQuestShareInBG
# 描述: 禁用在战场中共享任务。
# 默认:     0 - (禁用)
# 1 - (启用)

Battleground.DisableQuestShareInBG = 0

#
#    Battleground.DisableReadyCheckInBG
# 描述: 禁用在战场中发起准备确认。
# 默认:     0 - (禁用)
# 1 - (启用)

Battleground.DisableReadyCheckInBG = 0

#
#    Battleground.RewardWinnerHonorFirst
#    Battleground.RewardWinnerArenaFirst
#    Battleground.RewardWinnerHonorLast
#    Battleground.RewardWinnerArenaLast
#    Battleground.RewardLoserHonorFirst
#    Battleground.RewardLoserHonorLast
# 描述: 随机战场/活动战场奖励
# 默认:     30 - Battleground.RewardWinnerHonorFirst
# 25 - Battleground.RewardWinnerArenaFirst
# 15 - Battleground.RewardWinnerHonorLast
# 0  - Battleground.RewardWinnerArenaLast
# 5  - Battleground.RewardLoserHonorFirst
# 5  - Battleground.RewardLoserHonorLast

Battleground.RewardWinnerHonorFirst = 30
Battleground.RewardWinnerArenaFirst = 25
Battleground.RewardWinnerHonorLast  = 15
Battleground.RewardWinnerArenaLast  = 0
Battleground.RewardLoserHonorFirst  = 5
Battleground.RewardLoserHonorLast   = 5

#
#    Battleground.PlayerRespawn
# 描述: 战场玩家复活间隔(秒)。
# 默认:     30

Battleground.PlayerRespawn = 30

#
#    Battleground.RestorationBuffRespawn
# 描述: 战场恢复增益刷新时间(秒)。
# 默认:     20 (推荐 10+)

Battleground.RestorationBuffRespawn = 20

#
#    Battleground.BerserkingBuffRespawn
# 描述: 战场狂暴增益刷新时间(秒)。
# 默认:     120 (推荐 10+)

Battleground.BerserkingBuffRespawn = 120

#
#    Battleground.SpeedBuffRespawn
# 描述: 战场加速增益刷新时间(秒)。
# 默认:     150 (推荐 10+)

Battleground.SpeedBuffRespawn = 150

#
#    Battleground.Override.LowLevels.MinPlayers
# 描述: 覆盖所有低于 MaxPlayerLevel 等级每队所需的最少玩家数
# 作为未单独覆盖的战场的回退值(见下方各战场键)
# 默认:     0 (禁用)

Battleground.Override.LowLevels.MinPlayers = 0

#
#    Battleground.Override.LowLevels.MinPlayers.AV
#    Battleground.Override.LowLevels.MinPlayers.WS
#    Battleground.Override.LowLevels.MinPlayers.AB
#    Battleground.Override.LowLevels.MinPlayers.EY
#    Battleground.Override.LowLevels.MinPlayers.SA
#    Battleground.Override.LowLevels.MinPlayers.IC
# 描述: 按战场覆盖每队所需的最少玩家数,
# 对所有 < MaxPlayerLevel 的等级生效。
# AV = 奥特兰克山谷,WS = 战歌峡谷,AB = 阿拉希盆地,
# EY = 风暴之眼,SA = 远古海滩,IC = 征服之岛
# 解析顺序: 各战场单独键,其次是 Battleground.Override.LowLevels.MinPlayers,
# 再次才是 battleground_template 数据库值。
# 通过随机战场队列进入的比赛始终使用全局
# Battleground.Override.LowLevels.MinPlayers,而不会用各战场单独的键。
# 默认:     0 (禁用,使用 Battleground.Override.LowLevels.MinPlayers)

Battleground.Override.LowLevels.MinPlayers.AV = 0
Battleground.Override.LowLevels.MinPlayers.WS = 0
Battleground.Override.LowLevels.MinPlayers.AB = 0
Battleground.Override.LowLevels.MinPlayers.EY = 0
Battleground.Override.LowLevels.MinPlayers.SA = 0
Battleground.Override.LowLevels.MinPlayers.IC = 0

#
#    Battleground.Warsong.Flags
# 描述: 设置战歌峡谷一队获胜所需的夺旗数
# 默认:     3 (官方设定)
# 1 (最小值)

Battleground.Warsong.Flags = 3

#
#    Battleground.Arathi.CapturePoints
# 描述: 设置阿拉希战场一队获胜所需的占点数
# 默认:     1600 (WotLK)
# 2000 (Vanilla)

Battleground.Arathi.CapturePoints = 1600

#
#    Battleground.Alterac.Reinforcements
# 描述: 设置奥特兰克战场每队的增援总数
# (修改增援值后必须重启服务器)
# 默认:     600 (启用,WotLK)
# 500 (启用,MoP 设定)
# 0   (禁用,早期 Vanilla 设定,仅击杀 Boss 判胜)

Battleground.Alterac.Reinforcements = 600

#
#    Battleground.Alterac.ReputationOnBossDeath
# 描述: 设置奥特兰克战场击杀首领给予的声望点数
# (修改 ReputationOnBossDeath 值后必须重启服务器)
# 默认:     350 (WotLK)
# 389 (Vanilla)

Battleground.Alterac.ReputationOnBossDeath = 350

#
#    Battleground.EyeOfTheStorm.CapturePoints
# 描述: 设置风暴之眼战场一队获胜所需的占点数
# (不修改客户端时,界面的队伍最高得分不会遵循此参数)
# 默认:     1600 (WotLK,界面合规)
# 2000 (TBC,界面不合规)

Battleground.EyeOfTheStorm.CapturePoints = 1600

#
###################################################################################################

###################################################################################################
# 竞技场(ARENA)
#
#    Arena.PrepTime
# 描述: 竞技场准备阶段的秒数。
# 默认:     60

Arena.PrepTime = 60

#
#    Arena.MaxRatingDifference
# 描述: 评级比赛中两队之间的最大积分差。
# 默认:     150 - (启用)
# 0   - (禁用)

Arena.MaxRatingDifference = 150

#
#    Arena.RatingDiscardTimer
# 描述: 超过该毫秒数后匹配时忽略积分差,
# 组队匹配。
# 默认:     600000 - (启用,10 分钟)
# 0      - (禁用)

Arena.RatingDiscardTimer = 600000

#
#    Arena.PreviousOpponentsDiscardTimer
# 描述: 此前对手被忽略的毫秒数。
# 默认:     120000 - (启用,2 分钟 - 官方设定)
# 0      - (禁用)

Arena.PreviousOpponentsDiscardTimer = 120000

#
#    Arena.AutoDistributePoints
# 描述: 自动分发竞技场点数。
# 默认:     0 - (禁用)
# 1 - (启用)

Arena.AutoDistributePoints = 0

#
#    Arena.AutoDistributeInterval
# 描述: 自动分发竞技场点数的间隔天数
# 分发已启用。
# 默认:     7 - (每周)

Arena.AutoDistributeInterval = 7

#
#    Arena.GamesRequired
# 描述: 战队有资格参与竞技场点数分发所需参加的比赛场次。
# 默认:     10

Arena.GamesRequired = 10

#
#    Arena.QueueAnnouncer.Enable
# 描述: 在聊天中公告竞技场排队状态。
# 默认:     0 - (禁用)
# 1 - (启用)

Arena.QueueAnnouncer.Enable = 0

#
#    Arena.QueueAnnouncer.PlayerOnly
# 描述: 竞技场排队公告类型。
# 默认:     0 - (系统消息,所有人可见)
# 1 - (私密,仅排队玩家可见)

Arena.QueueAnnouncer.PlayerOnly = 0

#
#    Arena.QueueAnnouncer.Detail
# 描述: 竞技场排队公告的详细程度。
# 默认:     3 - (公告队名与积分)
# 2 - (仅公告队伍名称)
# 1 - (仅公告队伍积分)
# 0 - (不公告任何队伍信息)

Arena.QueueAnnouncer.Detail = 3

#
#    Arena.ArenaStartRating
# 描述: 新竞技场战队的初始积分。(适用于第 6 赛季及以后)
# 默认:     0

Arena.ArenaStartRating = 0

#
#    Arena.LegacyArenaStartRating
# 描述: 新竞技场战队的初始积分。(仅适用于第 1-5 赛季)
# 默认:     1500

Arena.LegacyArenaStartRating = 1500

#
#    Arena.ArenaStartPersonalRating
# 描述: 加入战队时的初始个人积分。
# 默认:     0

Arena.ArenaStartPersonalRating = 0

#
#    Arena.ArenaStartMatchmakerRating
# 描述: 玩家的初始匹配等级(MMR)。
# 默认:     1500

Arena.ArenaStartMatchmakerRating = 1500

#
#    Arena.ArenaWinRatingModifier1
# 描述: 获胜队伍积分低于 1300 时的加分修正
# 注意从 1000 到 1300 会自动逐渐下降到其一半
# (增大此值会给予更多积分)
# 默认:     48

Arena.ArenaWinRatingModifier1 = 48

#
#    Arena.ArenaWinRatingModifier2
# 描述: 获胜队伍积分不低于 1300 时的加分修正
# (增大此值会给予更多积分)
# 默认:     24

Arena.ArenaWinRatingModifier2 = 24

#
#    Arena.ArenaLoseRatingModifier
# 描述: 失败队伍的扣分修正
# (增大此值会扣除更多积分)
# 默认:     24

Arena.ArenaLoseRatingModifier = 24

#
#    Arena.ArenaMatchmakerRatingModifier
# 描述: 匹配等级(MMR)修正系数
# 默认:     24

Arena.ArenaMatchmakerRatingModifier = 24

#
#    ArenaTeam.CharterCost.2v2
#    ArenaTeam.CharterCost.3v3
#    ArenaTeam.CharterCost.5v5
# 描述: 公会契约的费用(铜币)。
# 默认:     800000  - (80 金币)
# 1200000 - (120 金币)
# 2000000 - (200 金币)

ArenaTeam.CharterCost.2v2 = 800000
ArenaTeam.CharterCost.3v3 = 1200000
ArenaTeam.CharterCost.5v5 = 2000000

#
#    MaxAllowedMMRDrop
# 描述: 部分玩家故意连败压低 MMR,再与弱者对战。
# 此设置防止 MMR 从历史最高值跌落过多。
# 例如,角色历史最高 MMR 为 2400,默认设置(MaxAllowedMMRDrop = 500)下该角色无论如何不会低于 1900 MMR。
# 默认:     500

MaxAllowedMMRDrop = 500

#
###################################################################################################

###################################################################################################
# 邮件(MAIL)
#
#    MailDeliveryDelay
# 描述: 发送物品时邮件送达延迟的秒数。
# 默认:     3600 - (1 小时)

MailDeliveryDelay = 3600

#
#    Mail.PushInboxOnDelivery
# 描述: 每当邮件送达收件人时,把收件箱推送给客户端,
# 在他们在线期间。
# 客户端会缓存邮箱,约一分钟内不会再次向服务器请求,
# 因此刚查看过邮箱的玩家再次打开时
# 在那一分钟结束、或执行 /reload、重新登录之前,看到的都是旧列表。
# 打开收件箱会原地刷新,可绕过该问题。
# 官方服务器并不这样做,且每次投递都要多发送
# 个收件箱封包(邮件多的角色可达约 32KB),因此除非
# 除非陈旧邮箱在你的服务器上确实造成问题。
# 默认:     0 - (禁用)
# 1 - (启用)

Mail.PushInboxOnDelivery = 0

#
#     LevelReq.Mail
# 描述: 角色收发邮件的等级要求。
# 默认:     1

LevelReq.Mail = 1

#
###################################################################################################

###################################################################################################
# 交通工具(TRANSPORT)
#
#    IsContinentTransport.Enabled
# 描述: 控制大陆交通工具(船舶、飞艇等)
# 默认:     1 - (启用)

IsContinentTransport.Enabled = 1

#
#    IsPreloadedContinentTransport.Enabled
# 描述: 是否预载交通工具?
# (不推荐在低端服务器使用,内存占用多 100%)
# 并且实在没有必要启用。
# 默认:     0 - (禁用)
#

IsPreloadedContinentTransport.Enabled = 0

#
###################################################################################################

###################################################################################################
# 聊天频道(CHAT CHANNEL)
#
#    StrictChannelNames
# 描述: 限制频道名称只能使用对应语言的字符集。
# 使用不允许的符号时禁止创建公会契约。
# 默认:     0 - (禁用,有限的按时区客户端检查)
# 1 - (启用,严格基础拉丁字符)
# 2 - (启用,严格按服务器区域字符,见 RealmZone 设置,
# 注意:        客户端需安装支持
# 该字符集。非官方本地化需要自定义字体,
# 需放在 clientdir/Fonts。
# 3 - (启用,基础拉丁字符 + 服务器时区字符)

StrictChannelNames = 0

#
#    AddonChannel
# 描述: 配置服务器对插件频道的控制(部分客户端
# 插件将无法正常工作)
# 默认:     1 - (启用)
# 0 - (禁用)

AddonChannel = 1

#
#    ChatFakeMessagePreventing
# 描述: 额外防护: 防止用空格伪造聊天消息。
# 将连续多个空白字符合并为一个。
# 不适用于插件语言,但可能破坏使用
# "普通"聊天消息向其他客户端发送数据。
# 默认:     1 - (启用,官方设定)
# 0 - (禁用)

ChatFakeMessagePreventing = 1

#
#    ChatStrictLinkChecking.Severity
# 描述: 检查聊天消息中的法术、物品、任务等游戏内链接。
# -1 - (仅校验链接数据有效,但允许自定义颜色)
# 默认:      0 - (仅校验链接数据与颜色有效,不检查文本)
# 1 - (额外校验链接文本与提供的数据一致)
# 注意:        若设为 '1',还必须为所有
# 服务器上正在使用的客户端语言。
# 若缺少任何文件,使用这些
# 语言的客户端消息很可能被服务器拦截。

ChatStrictLinkChecking.Severity = 0

#
#    ChatStrictLinkChecking.Kick
# 描述: 定义消息中包含非法控制字符时
# 被接收。
# 默认:     0 - (静默忽略消息)
# 1 - (忽略消息并踢出玩家)

ChatStrictLinkChecking.Kick = 0

#
#    ChatFlood.MessageCount
# 描述: 聊天防洪保护,触发禁言所需的消息条数。
# 默认:     10 - (启用)
# 0  - (禁用)

ChatFlood.MessageCount = 10

#
#    ChatFlood.MessageDelay
# 描述: 计入 ChatFlood.MessageCount 的消息间隔秒数。
# 默认:     1

ChatFlood.MessageDelay = 1

#
#    ChatFlood.AddonMessageCount
# 描述: 聊天防洪保护,触发禁言所需的插件消息条数。
# 默认:     100 - (启用)
# 0   - (禁用)

ChatFlood.AddonMessageCount = 100

#
#    ChatFlood.AddonMessageDelay
# 描述: 计入 ChatFlood.AddonMessageCount 的插件消息间隔秒数。
# 默认:     1

ChatFlood.AddonMessageDelay = 1

#
#    ChatFlood.MuteTime
# 描述: 违反 ChatFlood.MessageCount / ChatFlood.AddonMessageCount 的禁言秒数。
# 默认:     10

ChatFlood.MuteTime = 10

#
#    Chat.MuteFirstLogin
# 描述: 游戏 Chat.MuteTimeFirstLogin 分钟后才能说话。期间可用队伍与公会频道。
# 默认:     0 - (禁用)
# 1 - (启用)

Chat.MuteFirstLogin = 0

#
#    Chat.MuteTimeFirstLogin
# 描述: 玩家此后可正常说话的时间。
# 默认:     120 - (分钟)

Chat.MuteTimeFirstLogin = 120

#
#    Channel.RestrictedLfg
# 描述: 将 LookupForGroup 频道限制为已在 LFG 注册的角色。
# 默认:     1 - (启用,仅已注册 LFG 才可加入频道)
# 0 - (禁用,任何时间都可加入频道)

Channel.RestrictedLfg = 1

#
#    Channel.SilentlyGMJoin
# 描述: GM 角色静默加入频道。设为 1 时,频道踢人与封禁
# GM 执行的命令不会被广播。
# 默认:     0 - (禁用,加入时公告)
# 1 - (启用,加入时不公告)

Channel.SilentlyGMJoin = 0

#
#    ChatLevelReq.Channel
# 描述: 角色在聊天频道发言的等级要求。
# 默认:     1

ChatLevelReq.Channel = 1

#
#    ChatLevelReq.Whisper
# 描述: 角色密语其他角色的等级要求。
# 默认:     1

ChatLevelReq.Whisper = 1

#
#    ChatLevelReq.Say
# 描述: 角色使用说/大喊/表情的等级要求。
# 默认:     1

ChatLevelReq.Say = 1

#
#    PartyLevelReq
# 描述: 玩家可邀请入组的最低等级,即使不在
# 邀请好友列表。(在该好友列表中的玩家始终
# 即使等级较低也能收到邀请)
# 默认:     1

PartyLevelReq = 1

#
#    PreserveCustomChannels
# 描述: 存储自定义聊天频道设置,如密码、自动移交所有权,
# 或数据库中的封禁列表。需要启用才能保存自定义
# 自动所有权移交被禁用的世界/交易等频道。
# (.channel set ownership $channel off)
# 默认:     0 - (禁用,官方设定,最后一人离开后频道设置丢失)
# 1 - (启用)

PreserveCustomChannels = 0

#
#    PreserveCustomChannelDuration
# 描述: 自定义聊天频道被清理前需经过的天数
# 才会从数据库清理。仅启用了所有权移交的频道
# (默认行为)的频道将被清理。
# 默认:     14 - (启用,清理 14 天未使用的频道)
# 0  - (禁用,频道存储无限制)

PreserveCustomChannelDuration = 14

#
# ChatFilter.Whisper / ChatFilter.Say / ChatFilter.Yell / ChatFilter.Emote(私聊/说/大喊/表情过滤)
# 描述: 拦截包含 `chat_filter` 表中任何条目的聊天消息
# (子串匹配,不区分大小写)。
# 通过命令管理条目: .chatfilter add / .chatfilter remove / .chatfilter list
# 以及 .reload chat_filter。
# 官方设定: 仅启用密语过滤。
# 默认:     ChatFilter.Whisper = 1 - (启用)
# ChatFilter.Say     = 0 - (禁用)
# ChatFilter.Yell    = 0 - (禁用)
# ChatFilter.Emote   = 0 - (禁用)
#

ChatFilter.Whisper = 1
ChatFilter.Say     = 0
ChatFilter.Yell    = 0
ChatFilter.Emote   = 0

#
###################################################################################################

###################################################################################################
# 阵营交互(FACTION INTERACTION)
#
#    AllowTwoSide.Accounts
# 描述: 允许同一账号创建两个阵营的角色。
# 默认:     1 - (启用)
# 0 - (禁用)

AllowTwoSide.Accounts = 1

#
#    AllowTwoSide.Interaction.Calendar
# 描述: 允许跨阵营发送日历邀请。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Calendar = 0

#
#    AllowTwoSide.Interaction.Chat
# 描述: 允许跨阵营"说"聊天。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Chat = 0

#
#    AllowTwoSide.Interaction.Channel
# 描述: 允许跨阵营频道聊天。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Channel = 0

#
#    AllowTwoSide.Interaction.Group
# 描述: 允许跨阵营组队。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Group = 0

#
#    AllowTwoSide.Interaction.Guild
# 描述: 允许跨阵营加入公会。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Guild = 0

#
#    AllowTwoSide.Interaction.Arena
# 描述: 允许跨阵营加入竞技场战队。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Arena = 0

#
#    AllowTwoSide.Interaction.Auction
# 描述: 允许跨阵营拍卖。这会把所有拍卖行标记为中立,
# 并会对中立拍卖行的拍卖收取佣金。
# 默认:     0 - (禁用)
# 1 - (启用)

AllowTwoSide.Interaction.Auction = 0

#
#    TalentsInspecting
# 描述: 允许查看对立阵营角色的装备。
# 不影响处于 GM 模式的角色。
# 默认:     1 - (启用)
# 0 - (禁用)

TalentsInspecting = 1

#
#    ChangeFaction.MaxMoney
# 描述: 转换阵营时角色允许携带的最大金币数。
# 默认:      0 - 禁用
# >0 - 启用(金额单位为铜币)
# 示例:     若设为 10000,角色允许持有的金钱上限为 1 金。

ChangeFaction.MaxMoney = 0

#
###################################################################################################

###################################################################################################
# 好友招募(RECRUIT A FRIEND)
#
#    RecruitAFriend.MaxLevel
# 描述: 角色可享受好友招募
# 经验倍率。
# 默认:     60

RecruitAFriend.MaxLevel = 60

#
#    RecruitAFriend.MaxDifference
# 描述: 招募者与被招募者可享受招募福利的
# 好友招募的经验倍率叠加。
# 默认:     4

RecruitAFriend.MaxDifference = 4

#
#    MaxRecruitAFriendBonusDistance
# 描述: 角色与队伍之间可享受好友招募
# 经验倍率。
# 默认:     100

MaxRecruitAFriendBonusDistance = 100

#
###################################################################################################

###################################################################################################
# 日历(CALENDAR)
#
#    Calendar.DeleteOldEventsHour
# 描述: 每日删除旧日历事件的时刻。
# 范围:       0-23
# 默认:     6 - (早上 6 点)

Calendar.DeleteOldEventsHour = 6

#
###################################################################################################

###################################################################################################
# 游戏事件(GAME EVENT)
#
#    Event.Announce
# 描述: 公告游戏事件。
# 默认:     0 - (禁用)
# 1 - (启用)

Event.Announce = 0

#
###################################################################################################

###################################################################################################
# 世界状态(WORLD STATE)
#
#    Sunsreach.CounterMax
# 描述: 进入下一阶段所需的计数值
# 太阳之井夺回战役事件期间。
# 默认:     10000

Sunsreach.CounterMax = 10000

#
#    ScourgeInvasion.CounterFirst
#    ScourgeInvasion.CounterSecond
#    ScourgeInvasion.CounterThird
# 描述: 进入下一阶段所需的计数器阈值
# 默认:     50  - (ScourgeInvasion.CounterFirst)
# 100 - (ScourgeInvasion.CounterSecond)
# 150 - (ScourgeInvasion.CounterThird)

ScourgeInvasion.CounterFirst  = 50
ScourgeInvasion.CounterSecond = 100
ScourgeInvasion.CounterThird  = 150

#
###################################################################################################

###################################################################################################
# 拍卖行(AUCTION HOUSE)
#
#    AuctionHouse.WorkerThreads
# 描述: 要创建的拍卖行搜索工作线程数
# 默认:     1

AuctionHouse.WorkerThreads = 1

#
#    LevelReq.Auction
# 描述: 角色使用拍卖行的等级要求。
# 默认:     1

LevelReq.Auction = 1

#
#    Rate.Auction.Time
#    Rate.Auction.Deposit
#    Rate.Auction.Cut
# 描述: 拍卖倍率(拍卖时长、起拍时的押金、
# 拍卖结束时从成交价中扣除佣金)
# 默认:     1 - (Rate.Auction.Time)
# 1 - (Rate.Auction.Deposit)
# 1 - (Rate.Auction.Cut)

Rate.Auction.Time    = 1
Rate.Auction.Deposit = 1
Rate.Auction.Cut     = 1

#
###################################################################################################

###################################################################################################
# 角色导出(PLAYER DUMP)
#
#    PlayerDump.DisallowPaths
# 描述: 禁止在角色导出输出文件中使用路径
# 默认:     1

PlayerDump.DisallowPaths = 1

#
#    PlayerDump.DisallowOverwrite
# 描述: 禁止角色导出覆盖已有文件
# 默认:     1

PlayerDump.DisallowOverwrite = 1

#
###################################################################################################

###################################################################################################
# 自定义(CUSTOM)
#
#    ICC.Buff.Alliance
#    ICC.Buff.Horde
# 描述: 指定 ICC 增益
# 注意:        修改这些值后必须重启服务器!
# 示例:     | 法术 ID  | 数量   | 阵营     |
# |     73762 |     5% | 联盟     |
# |     73824 |    10% | 联盟     |
# |     73825 |    15% | 联盟     |
# |     73826 |    20% | 联盟     |
# |     73827 |    25% | 联盟     |
# |     73828 |    30% | 联盟     |
# |     73816 |     5% | 部落     |
# |     73818 |    10% | 部落     |
# |     73819 |    15% | 部落     |
# |     73820 |    20% | 部落     |
# |     73821 |    25% | 部落     |
# |     73822 |    30% | 部落     |
# 默认:     ICC.Buff.Alliance = 73828
# ICC.Buff.Horde    = 73822

ICC.Buff.Alliance = 73828
ICC.Buff.Horde    = 73822

#
#    WipeGunshipBlizzlike.Enable
# 描述: 甲板上没有玩家时团灭飞艇战。
# 默认:     1 - (官方设定)

WipeGunshipBlizzlike.Enable = 1

#
#    Minigob.Manabonk.Enable
# 描述: 启用/禁用小地精魔法棒(Minigob Manabonk)
# 默认:     1

Minigob.Manabonk.Enable = 1

#
#    Calculate.Creature.Zone.Area.Data
# 描述: 加载时计算生物的 zoneId / areaId 并存入 creature 表
# 警告: 世界服务器启动会非常慢。仅应用于调试。
# 默认:     0 - (不显示)

Calculate.Creature.Zone.Area.Data = 0

#
#    Calculate.Gameoject.Zone.Area.Data
# 描述: 加载时计算游戏物体的 zoneId / areaId 并存入 gameobject 表
# 警告: 世界服务器启动会非常慢。仅应用于调试。
# 默认:     0 - (不显示)

Calculate.Gameoject.Zone.Area.Data = 0

#
#    DailyRBGArenaPoints.MinLevel
# 描述: 允许在 70 级首场评级战场获胜时获得竞技场点数。
# 默认:     71 - (官方设定)

DailyRBGArenaPoints.MinLevel = 71

#
#    MunchingBlizzlike.Enabled
# 描述: 启用官方服实现的"吞咬"机制,如战士的撕裂、法师的点燃
# 默认:     1 - (官方设定)

MunchingBlizzlike.Enabled = 1

#
#    Daze.Enabled
# 描述: 启用/禁用怪物近战攻击造成眩晕的概率。
# 默认:     1 - (官方设定)

Daze.Enabled = 1

#
#    InfiniteAmmo.Enabled
# 描述: 启用/禁用远程攻击与投掷武器的弹药消耗。
# 默认:     0 - (官方设定)

InfiniteAmmo.Enabled = 0

#
###################################################################################################

###################################################################################################
# 调试(DEBUG)
#
#    Debug.Battleground
# 描述: 启用/禁用战场 1v0 模式。(启用后游戏内命令将被禁用。)
# 默认:     0 - (禁用)
# 1 - (启用)

Debug.Battleground = 0

#
#    Debug.Arena
# 描述: 启用/禁用竞技场 1v1 模式。(启用后游戏内命令将被禁用。)
# 默认:     0 - (禁用)
# 1 - (启用)

Debug.Arena = 0

#
#    Debug.LFG
# 描述: 启用/禁用 LFG 单人排队模式。(启用后游戏内命令将被禁用。)
# 默认:     0 - (禁用)
# 1 - (启用)

Debug.LFG = 0

#
###################################################################################################

###################################################################################################
# 动态重生设置(DYNAMIC RESPAWN)
#
#
#    Respawn.DynamicRateCreature
# 描述: 控制生物重生时间如何随区域内玩家数量调整。
# 玩家数不超过设定值时重生时间保持不变。
# 玩家数量超过此值后,重生时间按比例缩短
# (例如,玩家数量翻倍时重生时间减半;玩家数量三倍时重生速度加快三倍)。
# 不影响副本内生物、Boss 或任务 NPC。
# 公式:     adjustFactor = rate / playerCount
# RespawnTime = RespawnTime * adjustFactor(重生时间 = 原重生时间 × 调整系数)
# 默认:     1 (禁用)

Respawn.DynamicRateCreature = 1

#
#    Respawn.DynamicMinimumCreature
# 描述: 动态缩放下生物的最短重生时间。
# 默认:     10 - (10 秒)

Respawn.DynamicMinimumCreature = 10

#
#    Respawn.DynamicRateGameObject
# 描述: 控制游戏物体重生时间如何随区域内玩家数量调整。
# 玩家数不超过设定值时重生时间保持不变。
# 玩家数量超过此值后,重生时间按比例缩短
# (例如,玩家数量翻倍时重生时间减半;玩家数量三倍时重生速度加快三倍)。
# 不影响副本内物体或任务 NPC。
# 公式:     adjustFactor = rate / playerCount
# RespawnTime = RespawnTime * adjustFactor(重生时间 = 原重生时间 × 调整系数)
# 默认:     1 (禁用)

Respawn.DynamicRateGameObject = 1

#
#    Respawn.DynamicMinimumGameObject
# 描述: 动态缩放下游戏物体的最短重生时间。
# 默认:     10 - (10 秒)

Respawn.DynamicMinimumGameObject = 10

#
#    Respawn.DynamicEscortNPC
# 描述: 为护送任务 NPC 启用动态重生行为。
# 启用后,刷新点组中标记为 ESCORTQUESTNPC 的护送 NPC
# 将使用特殊的重生处理。
# 默认:     0 - (禁用)

Respawn.DynamicEscortNPC = 0

#
#    Respawn.ForceCompatibilityMode
# 描述: 强制所有刷新点使用旧版(兼容模式)重生行为,
# 无论其刷新点组标志如何。启用后,生物与
# 游戏物体仍像 AzerothCore 一贯的那样原地重生。
# 设为 1 对所有刷新点强制使用旧版行为。
# 默认:     0 - (禁用,由刷新点组控制重生模式)

Respawn.ForceCompatibilityMode = 0

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# 游戏设置 结束                                                                                         #
#                                                                                                 #
###################################################################################################

###################################################################################################
#                                                                                                 #
# 集群设置 开始                                                                                         #
#                                                                                                 #
###################################################################################################

###################################################################################################
# 集群设置(CLUSTER SETTINGS)
#
# 此功能为实验性,仍在开发中。它启用集群模式,允许单个
# 服务器(领域)运行多个 worldserver 进程分担负载。除 worldserver 外,
# 还需其他配套服务才能正常工作。如遇问题,请上报
# 给 ToCloud9 项目: https://github.com/walkline/ToCloud9。
#
#    Cluster.Enabled
# 描述: 启用/禁用集群模式。
# 安全: 集群模式下 ToCloud9 网关是受信任的
# 认证边界。本 worldserver 随后跳过会话密钥
# 摘要校验、封包加密、反作弊(Warden)、IP/国家锁、
# 封禁与最低安全等级校验,而
# 角色归属检查。worldserver 端口必须
# 只能由网关访问,绝不能让玩家直连。
# 默认: 0 - (禁用)
# 1 - (启用)

Cluster.Enabled=0

#
#    Cluster.AvailableMaps
# 描述: 本服务器可用的地图 ID 列表。
# 示例:    "" - (可处理任何地图)
# "0,1,573"

Cluster.AvailableMaps=""

#
#    Cluster.IsCrossrealm
# 描述: 为跨服架构启用跨服功能。
# 启用后,需要连接到 MySQL 跨服反向代理。
# 默认: 0 - (禁用)
# 1 - (启用)

Cluster.IsCrossrealm=0

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# 集群设置 结束                                                                                         #
#                                                                                                 #
###################################################################################################
