#
#    Log.Async.Enable
# 描述: 启用异步消息日志。
# 默认:     0 - (禁用)
# 1 - (启用)

Log.Async.Enable = 0

#
###################################################################################################

###################################################################################################
# 指标统计(METRIC)
#
# 以下配置控制发送到指标数据库(目前为 InfluxDB)的统计数据
#
#    Metric.Enable
# 描述: 启用向指标数据库发送统计数据。
# 默认:     0 - (禁用)
# 1 - (启用)
#

Metric.Enable = 0

#
#    Metric.InfluxDB
# 描述:     InfluxDB 连接设置。
# InfluxDB v1: 只需填写 Metric.InfluxDB.Connection。
# 示例:         Metric.InfluxDB.Connection = "主机名;端口;数据库"
# InfluxDB v2: 需填写每一项字段。
# 注意:            目前 Grafana 无法使用提供的 json 文件可视化
# 数据(来自 InfluxDB v2)。
# 示例:         Metric.InfluxDB.Connection = "主机名;端口"
#                         Metric.InfluxDB.v2 =         0 - (Disabled)
# 1 - (启用)
#                         Metric.InfluxDB.Org =        "my-org"
#                         Metric.InfluxDB.Bucket =     "my-bucket"
#                         Metric.InfluxDB.Token =      "my-token"
#

Metric.InfluxDB.Connection = "127.0.0.1;8086;worldserver"
Metric.InfluxDB.v2 = 0
Metric.InfluxDB.Org = ""
Metric.InfluxDB.Bucket = ""
Metric.InfluxDB.Token = ""

#
#    Metric.Interval
# 描述: 每批数据发送的间隔(秒)。
# 间隔越长单批数据量越大。若批量
# 过大,可能会被拒绝。
# 默认:     1 秒

Metric.Interval = 1

#
#    Metric.OverallStatusInterval
# 描述: 每次采集 worldserver 整体状态数据的间隔(秒)
# 默认:     1 秒

Metric.OverallStatusInterval = 1

#
# Metric 阈值配置: 给定 metric "名称"
#    Metric.Threshold.name
# 描述: 跳过发送低于配置值的统计数据。
# 若阈值被注释掉,该指标将被忽略。
# 仅影响源码中以 METRIC_DETAILED_TIMER 记录的指标。
# 默认禁用。需要 WITH_DETAILED_METRICS CMake 开关。
#
# 格式:      整数值
#

#Metric.Threshold.world_update_sessions_time = 100
#Metric.Threshold.worldsession_update_opcode_time = 50

#
###################################################################################################

###################################################################################################
# 服务器(SERVER)
#
#    BirthdayTime
# 描述: 设为项目诞生的 UNIX 时间戳。默认为 2008 年 10 月 2 日(周四)
# 默认:     1222964635

BirthdayTime = 1222964635

#
#    PlayerLimit
# 描述: 世界内的最大玩家数。不含 Mod、GM 与管理员。
# 重要:   若想阻止普通玩家、仅允许 Mod/GM/管理员进入
# 请使用数据库字段 "auth.realmlist.allowedSecurityLevel"。
# 默认:     1000 - (启用)
# 1+   - (启用)
# 0    - (禁用,无限制)

PlayerLimit = 1000

#
#    World.RealmAvailability
# 描述: 启用后,玩家将正常进入服务器。
# 即使服务器(领域)被禁用,仍可创建角色。
# 默认:     1 - (启用)
# 0 - (禁用)

World.RealmAvailability = 1

#
#    GameType
# 描述: 服务器类型。
# 默认:     0  - (普通 NORMAL)
# 1  - (PVP)
# 4  - (普通 NORMAL)
# 6  - (角色扮演 RP)
# 8  - (角色扮演 PVP RPPVP)
# 16 - (FFA_PVP,除休息区外所有区域自由 PVP,类似竞技场
# 激活地点与圣所)

GameType = 0

#
#    RealmZone
# 描述: 服务器区域。设置角色名称等允许使用的字符集。
# 默认:     1  - (开发   - 任意语言)
# 2  - (美国          - 扩展拉丁)
# 3  - (大洋洲        - 扩展拉丁)
# 4  - (拉丁美洲      - 扩展拉丁)
# 5  - (锦标赛        - 创建时基础拉丁,登录后任意)
# 6  - (韩国          - 东亚字符)
# 7  - (锦标赛        - 创建时基础拉丁,登录后任意)
# 8  - (英语          - 扩展拉丁)
# 9  - (德语          - 扩展拉丁)
# 10 - (法语           - 扩展拉丁)
# 11 - (西班牙语      - 扩展拉丁)
# 12 - (俄语          - 西里尔)
# 13 - (锦标赛        - 创建时基础拉丁,登录后任意)
# 14 - (台湾          - 东亚字符)
# 15 - (锦标赛        - 创建时基础拉丁,登录后任意)
# 16 - (中国          - 东亚字符)
# 17 - (CN1           - 创建时基础拉丁,登录后任意)
# 18 - (CN2           - 创建时基础拉丁,登录后任意)
# 19 - (CN3           - 创建时基础拉丁,登录后任意)
# 20 - (CN4           - 创建时基础拉丁,登录后任意)
# 21 - (CN5           - 创建时基础拉丁,登录后任意)
# 22 - (CN6           - 创建时基础拉丁,登录后任意)
# 23 - (CN7           - 创建时基础拉丁,登录后任意)
# 24 - (CN8           - 创建时基础拉丁,登录后任意)
# 25 - (锦标赛        - 创建时基础拉丁,登录后任意)
# 26 - (测试服务器    - 任意语言)
# 27 - (锦标赛        - 创建时基础拉丁,登录后任意)
# 28 - (QA 服务器     - 任意语言)
# 29 - (CN9           - 创建时基础拉丁,登录后任意)

RealmZone = 1

#
#    DBC.Locale
# 描述: DBC 语言设置。
# 默认:     255 - (自动检测)
# 0   - (英语)
# 1   - (韩语)
# 2   - (法语)
# 3   - (德语)
# 4   - (中文)
# 5   - (台湾繁体)
# 6   - (西班牙语)
# 7   - (墨西哥西班牙语)
# 8   - (俄语)

DBC.Locale = 255

#
#    Expansion
# 描述: 允许服务器使用资料片内容。会检查资料片相关的
# 地图文件、客户端兼容性与职业/种族角色创建。
# 默认:     2 - (资料片 2)
# 1 - (资料片 1)
# 0 - (禁用,忽略并停用资料片内容(地图、种族、职业)

Expansion = 2

#
#    ClientCacheVersion
# 描述: 用于重置客户端缓存的版本号。使用任何
# 尚未从数据库加载或最近未用于触发客户端缓存重置。
# 默认:     0 - (使用世界库 version.cache_id 字段的值)

ClientCacheVersion = 0

#
#    SocketTimeOutTime
# 描述: 连接在角色选择界面空闲
# 选择界面的连接将被断开。
# 默认:     900000 - (15 分钟)

SocketTimeOutTime = 900000

#
#    SocketTimeOutTimeActive
# 描述: 空闲连接被断开的毫秒数,
# 登录到世界。
# 客户端每 30 秒发送一次保活包。不建议设为 <= 30 秒。
# 默认:     60000 - (1 分钟)

SocketTimeOutTimeActive = 60000

#
#    MaxOverspeedPings
# 描述: 触发角色掉线的超速 ping 计数上限。
# 默认:     2  - (启用,最小值)
# 3+ - (启用,踢出前更多检查)
# 0  - (禁用)

MaxOverspeedPings = 2

#
#    DisconnectToleranceInterval
# 描述: 允许在掉线指定秒数后跳过排队。
# 默认:     0

DisconnectToleranceInterval = 0

#
#    EnableLoginAfterDC
# 描述: 未正常登出(点击退出并等待 20 秒)后,
# 角色会在游戏世界中停留整整一分钟,即使客户端连接已断开。
# 此行为可防止例如用 Alt+F4 卡 Boss 战
# 跳过关键 Boss 技能,或在 PVP 中逃离对手。
# 此设置用于允许/禁止玩家重新登录仍留在世界中的角色。
# 默认:     1 - (点击"进入世界"后玩家将重新登录到仍在世界中的角色)
# 0 - (点击"进入世界"后,玩家尝试登录该角色时会收到错误消息
# 仍留在世界中时,需等待一分钟角色才会从世界中移除)

EnableLoginAfterDC = 1

#
#    MinWorldUpdateTime
# 描述: 世界更新 tick 之间的最小间隔毫秒数(适用于基本空闲的服务器)。
# 默认:     1 - (0.001 秒)

MinWorldUpdateTime = 1

#
#    UpdateUptimeInterval
# 描述: 服务器在线时长的更新周期(分钟)。
# 默认:     10 - (10 分钟)
# 1+

UpdateUptimeInterval = 10

#
#    MaxCoreStuckTime
# 描述: 服务器卡死后强制崩溃前的秒数。
#                     FreezeDetector
# 默认:     0   - (禁用)
# 10+ - (启用,推荐 30+)
# 注意:        启用且值过低时可能导致意外崩溃。

MaxCoreStuckTime = 0

#
#    SaveRespawnTimeImmediately
# 描述: 生物死亡、游戏物体被使用/打开时保存重生时间。
# 默认:     1 - (启用,立即保存重生时间)
# 0 - (禁用,在网格卸载时保存重生时间)

SaveRespawnTimeImmediately = 1

#
#    Server.LoginInfo
# 描述: 登录时显示核心版本(.server info)。
# 默认:     0 - (禁用)
# 1 - (启用)

Server.LoginInfo = 0

#
#    ShowKickInWorld
# 描述: 决定某事件发生时是否向全服广播消息
# 玩家将被踢出。
# 默认:     0 - (禁用)
# 1 - (启用)

ShowKickInWorld = 0

#
#    ShowMuteInWorld
# 描述: 决定某事件发生时是否向全服广播消息
# 玩家将被禁言。
# 默认:     0 - (禁用)
# 1 - (启用)

ShowMuteInWorld = 0

#
#    ShowBanInWorld
# 描述: 决定某事件发生时是否向全服广播消息
# 玩家将被封禁。
# 默认:     0 - (禁用)
# 1 - (启用)

ShowBanInWorld = 0

#
#    MaxWhoListReturns
# 描述: 设置 /who 列表及界面返回的最大玩家数。
# 默认:     49 - (稳定)

MaxWhoListReturns = 49

#
#    PreventAFKLogout
# 描述: 防止挂机玩家被登出
# 默认:     0 - (禁用)
# 1 - (启用,防止挂机玩家在圣所区域被登出)
# 2 - (启用,防止挂机玩家在所有区域被登出)

PreventAFKLogout = 0

#
###################################################################################################

###################################################################################################
# 封包伪造防护设置(PACKET SPOOF PROTECTION)
#
#    PacketSpoof.BanMode
# 描述: 若 PacketSpoof.Policy 为 2,此项决定封禁方式。
# 取值:      0 - 封禁账号
# 1 - 封禁 IP
# 注意:        出于逻辑原因不支持按角色封禁。
#

PacketSpoof.BanMode = 0

#
#    PacketSpoof.BanDuration
# 描述: 封禁时长(秒)。仅当 PacketSpoof.Policy 设为 2 时有效。
# 设为 0 表示永久封禁。
# 默认:     86400 秒 (1 天)
#

PacketSpoof.BanDuration = 86400

#
###################################################################################################

###################################################################################################
# 反作弊设置(WARDEN SETTINGS)
#
#    Warden.Enabled
# 描述: 启用 Warden 反作弊系统。
# 默认:     1 - (启用)
# 0 - (禁用)

Warden.Enabled = 1

#
#    Warden.NumMemChecks
# 描述: 每个检查周期发送给客户端的 Warden 内存检查数量。
# 默认:     3 - (启用)
# 0 - (禁用)

Warden.NumMemChecks = 3

#
#    Warden.NumLuaChecks
# 描述: 每个检查周期发送给客户端的 Warden LUA 检查数量。
# 默认:     1 - (启用)
# 0 - (禁用)

Warden.NumLuaChecks = 1

#
#    Warden.NumOtherChecks
# 描述: 每个请求中除内存检查外加入的其他 Warden 检查数量
# 每个检查周期。
# 默认:     7 - (启用)
# 0 - (禁用)

Warden.NumOtherChecks = 7

#
#    Warden.ClientResponseDelay
# 描述: 客户端无响应被断开前的秒数。
# 默认:     600 - (10 分钟)
# 0 - (禁用,客户端不会被踢出)

Warden.ClientResponseDelay = 600

#
#    Warden.ClientCheckHoldOff
# 描述: 向客户端发送下一次检查请求前等待的秒数。
# 数值过小会增加客户端与服务端的流量和负载。
# 默认:     30 - (30 秒)
# 0  - (尽快发送校验)

Warden.ClientCheckHoldOff = 30

#
#    Warden.ClientCheckFailAction
# 描述: 客户端校验失败时执行的默认动作。动作可
# 可通过 characters 库的 warden_action 表对每个检查单独覆盖
#                     database.
# 默认:     0 - (禁用,仅记录日志)
# 1 - (踢出)
# 2 - (封禁)

Warden.ClientCheckFailAction = 0

#
#    Warden.BanDuration
# 描述: ClientCheckFailAction 设为封禁时账号被封的秒数,
# 封禁。
# 默认:     86400 - (24 小时)
# 0     - (永久封禁)

Warden.BanDuration = 86400

#
###################################################################################################

###################################################################################################
# 自动广播(AUTO BROADCAST)
#
#    AutoBroadcast.On
# 描述: 启用自动广播。
# 默认:     0 - (禁用)
# 1 - (启用)

AutoBroadcast.On = 0

#
#    AutoBroadcast.Center
# 描述: 自动广播的显示方式。
# 默认:     0 - (公告)
# 1 - (通知)
# 2 - (两者)

AutoBroadcast.Center = 0

#
#    AutoBroadcast.Timer
# 描述: 自动广播的计时器(毫秒)。
# 默认:     60000 - (60 秒)

AutoBroadcast.Timer = 60000

#
#    AutoBroadcast.MinDisableLevel
# 描述: 启用 EnablePlayerSettings 时,禁用自动广播公告所需的最低等级。
# 默认:     0 - (不允许禁用)

AutoBroadcast.MinDisableLevel = 0

#
###################################################################################################

###################################################################################################
# 可见性与距离(VISIBILITY AND DISTANCES)
#
#    Visibility.GroupMode
# 描述: 组队可见性模式。定义哪些组队始终能侦测到潜行/隐身的
# 同团队、同队伍或同阵营的角色。
# 默认:     1 - (团队)
# 0 - (小队)
# 2 - (阵营)

Visibility.GroupMode = 1

#
#    Visibility.Distance.Continents
#    Visibility.Distance.Instances
#    Visibility.Distance.BGArenas
# 描述: 可见其他玩家或游戏物体的距离。
# 官方服务器大陆可见性约 100 码,战场/竞技场约 250 码。
# 副本默认约 170。
# 最大: 250
# 最小值为最大仇恨半径(45)* Rate.Creature.Aggro
# 默认:     100 - (Visibility.Distance.Continents)
# 170 - (Visibility.Distance.Instances)
# 250 - (Visibility.Distance.BGArenas)

Visibility.Distance.Continents = 100
Visibility.Distance.Instances = 170
Visibility.Distance.BGArenas = 250

#
#    Visibility.ObjectSparkles
# 描述: 是否在与进行中任务相关的游戏物体上显示闪光效果。
# 默认:     1 - (显示闪光)
# 0 - (隐藏闪光)

Visibility.ObjectSparkles = 1

#
#    Visibility.ObjectQuestMarkers
# 描述: 像任务 NPC 一样在游戏物体上方显示任务图标。
# 默认:     1 - (显示任务标记,2.3 补丁后行为)
# 0 - (隐藏任务标记,2.3 补丁前行为)

Visibility.ObjectQuestMarkers = 1

#
###################################################################################################

###################################################################################################
# 地图(MAPS)
#
#    MapUpdateInterval
# 描述: 地图更新间隔(毫秒)。
# 默认:     10 - (0.01 秒)

MapUpdateInterval = 10

#
#    MapUpdate.Threads
# 描述: 地图更新线程数。
# 默认:     1

MapUpdate.Threads = 1

#
#    MoveMaps.Enable
# 描述: 启用/禁用基于 mmaps 的寻路(推荐)。
# 默认:     0 - (禁用)
# 1 - (启用)

MoveMaps.Enable = 1

#
#    vmap.enableLOS
#    vmap.enableHeight
# 描述: VMap 对视线与高度计算的支持。
# 默认:     1 - (启用,vmap.enableLOS)
# 1 - (启用,vmap.enableHeight)
# 0 - (禁用)

vmap.enableLOS    = 1
vmap.enableHeight = 1

#
#    vmap.petLOS
# 描述: 对宠物检查视线,避免其隔墙攻击。
# 默认:     1 - (启用,宠物每次攻击都会检查视线)
# 0 - (禁用,CPU 占用略低)

vmap.petLOS = 1

#    vmap.BlizzlikePvPLOS
# 描述: 对战场/竞技场的游戏物体与装饰物检查视线(如战歌峡谷的树桩)。
# 默认:     1 - (启用,玩家可以穿过树桩等物体施放法术)。
# 0 - (禁用,玩家将无法穿过树桩等物体施放法术)。

vmap.BlizzlikePvPLOS = 1

#
#   vmap.BlizzlikeLOSInOpenWorld
# 描述: 检查开放世界游戏物体的视线。
# 默认:     1 (启用,玩家可以穿过开放世界中的树桩等物体施放法术)。
# 0 (禁用,玩家将无法穿过开放世界中的树桩等物体施放法术)。

vmap.BlizzlikeLOSInOpenWorld = 1

#
#    vmap.enableIndoorCheck
# 描述: 基于 VMap 的室内检测,用于移除仅限室外的光环(坐骑等)。
# 默认:     1 - (启用)
# 0 - (禁用,CPU 占用略低)

vmap.enableIndoorCheck = 1

#
#    DetectPosCollision
# 描述: 检查最终移动位置、召唤位置等是否与
# 其他物体或墙体(墙体仅当启用 vmaps 时)。
# 默认:     1 - (启用)
# 0 - (禁用,位置精度较低但 CPU 占用更少)

DetectPosCollision = 1

#
#    CheckGameObjectLoS
# 描述: 在视线检查中包含动态游戏物体(门、箱子等)。
# 这会略微增加 CPU 占用。
# 默认:     1 - (启用)
# 0 - (禁用,可能破坏部分 Boss 战)

CheckGameObjectLoS = 1

#
#    PreloadAllNonInstancedMapGrids
# 描述: 预载所有非副本地图的全部网格。这将占用大量
# 额外内存(约 9 GB),并使服务器启动更慢,
# 但在高人数服务器上使用可提升性能。
# 它还会激活所有被标记为 active 的生物(例如地狱火半岛的
# (地狱火半岛的魔能机甲)在服务器启动时激活。
# 默认:     0 - (禁用)
# 1 - (启用)

PreloadAllNonInstancedMapGrids = 0

#
#     DontCacheRandomMovementPaths
# 描述: 随机移动路径(由 MoveMaps 计算)可缓存以节省 CPU,
# 但这可能占用大量内存,将此选项设为 1 可避免。
# 对高人气服务器的建议是内存充足并将此值设为 0。
# 默认:     0 - (缓存路径,占用更多内存)
# 1 - (不缓存,CPU 占用更高)

DontCacheRandomMovementPaths = 0

#
###################################################################################################

###################################################################################################
# 天气(WEATHER)
#
#    ActivateWeather
# 描述: 启用天气系统。
# 默认:     1 - (启用)
# 0 - (禁用)

ActivateWeather = 1

#
#    ChangeWeatherInterval
# 描述: 天气更新间隔(毫秒)。
# 默认:     600000 - (10 分钟)

ChangeWeatherInterval = 600000

#
###################################################################################################

###################################################################################################
# 工单(TICKETS)
#
#    AllowTickets
# 描述: 允许/禁止提交新工单。
# 默认:     1 - (启用)
# 0 - (禁用)

AllowTickets = 1

#
#     LevelReq.Ticket
# 描述: 角色提交工单的等级要求。
# 默认:     1

LevelReq.Ticket = 1

#    DeletedCharacterTicketTrace
# 描述: 保留已删除角色所开工单的记录
# gm_ticket.playerGuid 将为 0,旧 GUID 与角色名
# 将写入 gm_ticket.comment
# 默认:     0 - (禁用)
# 1 - (启用)

DeletedCharacterTicketTrace = 0

#
###################################################################################################

###################################################################################################
# 命令(COMMAND)
#
#    AllowPlayerCommands
# 描述: 允许玩家使用命令。
# 默认:     1 - (启用)
# 0 - (禁用)

AllowPlayerCommands = 1

#
#    Command.LookupMaxResults
# 描述: .lookup 命令显示的结果数量。
# 默认:     0 - (无限制)

Command.LookupMaxResults = 0

#
#    Die.Command.Mode
# 描述: .die 命令击杀不触发掉落等事件。
# 默认:     1 - (启用)
# 0 - (禁用)

Die.Command.Mode = 1

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# 服务器系统设置 结束                                                                                      #
#                                                                                                 #
###################################################################################################

###################################################################################################
#                                                                                                 #
# 游戏设置 开始                                                                                         #
#                                                                                                 #
###################################################################################################

###################################################################################################
# 游戏管理员(GAME MASTER)
#
#    GM.LoginState
# 描述: 登录时 GM 的模式。
# 默认:     2 - (最后一次保存状态)
# 0 - (禁用)
# 1 - (启用)

GM.LoginState = 2

#
#    GM.Visible
# 描述: 登录时 GM 的可见性。
# 默认:     2 - (最后一次保存状态)
# 0 - (不可见)
# 1 - (可见)

GM.Visible = 2

#
#    GM.Chat
# 描述: 登录时 GM 的聊天模式。
# 默认:     2 - (最后一次保存状态)
# 0 - (禁用)
# 1 - (启用)

GM.Chat = 2

#
#    GM.WhisperingTo
# 描述: GM 默认是否接受玩家密语。
# 默认:     2 - (最后一次保存状态)
# 0 - (禁用)
# 1 - (启用)

GM.WhisperingTo = 2

#
#    GM.InGMList.Level
# 描述: 非 GM 状态(.gm off)下 GM 列表中显示的最高 GM 等级(若启用)。
# 默认:     3 - (任何人)
# 0 - (仅玩家)
# 1 - (仅管理员)
# 2 - (仅游戏管理员)

GM.InGMList.Level = 3

#
#    GM.InWhoList.Level
# 描述: /who 列表中显示的最高 GM 等级(若可见)。
# 默认:     3 - (任何人)
# 0 - (仅玩家)
# 1 - (仅管理员)
# 2 - (仅游戏管理员)

GM.InWhoList.Level = 3

#
#    GM.StartLevel
# 描述: GM 角色的初始等级。
# 默认:     1

GM.StartLevel = 1

#
#    GM.AllowInvite
# 描述: 允许玩家邀请 GM 角色。
# 默认:     0 - (禁用)
# 1 - (启用)

GM.AllowInvite = 0

#
#    GM.AllowFriend
# 描述: 允许玩家把 GM 角色加为好友。
# 默认:     0 - (禁用)
# 1 - (启用)

GM.AllowFriend = 0

#
#    GM.LowerSecurity
# 描述: 允许低权限等级对高权限等级
#                     characters.
# 默认:     0 - (禁用)
# 1 - (启用)

GM.LowerSecurity = 0

#
#    GM.TicketSystem.ChanceOfGMSurvey
# 描述: 工单处理完成后发送 GM 调查问卷的概率。
# 默认:     50 - (启用)
# 0  - (禁用)

GM.TicketSystem.ChanceOfGMSurvey = 50

#
###################################################################################################

###################################################################################################
# 作弊(CHEAT)
#
#    DisableWaterBreath
# 描述: 使用水下呼吸所需的权限等级。
# 默认:     4 - (禁用)
# 0 - (启用,所有人)
# 1 - (启用,Mod/GM/管理员)
# 2 - (启用,GM/管理员)
# 3 - (启用,管理员)

DisableWaterBreath = 4

#
#    AllFlightPaths
# 描述: 角色创建后即掌握全部飞行点(含两个阵营)。
# 默认:     0 - (禁用)
# 1 - (启用)

AllFlightPaths = 0

#
#    TaxiFlightSpeed
# 描述: 玩家沿飞行航线旅行时的移动速度。
# 范围:       >0.01-50.0
# 默认:     32.0 - (官方设定)
# 注意:        超过 50.0 的值会被拒绝并回落到默认值 32.0。

TaxiFlightSpeed = 32.0

#
#    InstantFlightPaths
# 描述: 飞行航线将直接把玩家送达目的地,
# 让他们在飞行途中等待。
# 默认:     0 - (禁用)
# 1 - (启用)
# 2 - (启用,但玩家可在每个飞行管理员处开关即时飞行)

InstantFlightPaths = 0

#
#    AlwaysMaxSkillForLevel
# 描述: 玩家登录或升级时自动获得满技能等级,
#                     up.
# 默认:     0 - (禁用)
# 1 - (启用)

AlwaysMaxSkillForLevel = 0

#
#    AlwaysMaxWeaponSkill
# 描述: 玩家登录时自动获得满武器/防御技能,
# 或升级。
# 默认:     0 - (禁用)
# 1 - (启用)

AlwaysMaxWeaponSkill = 0

#
#    PlayerStart.AllReputation
# 描述: 玩家开局即拥有所需的多数高等级声望,
# 用于物品、坐骑等。
# 默认:     0 - (禁用)
# 1 - (启用)

PlayerStart.AllReputation = 0

#
#    PlayerStart.CustomSpells
# 描述: 启用后,玩家开局即拥有
# playercreateinfo_spell_custom 表。
# 默认:     0 - (禁用)
# 1 - (启用)

PlayerStart.CustomSpells = 0

#
#    PlayerStart.MapsExplored
# 描述: 角色开局即探索全部地图。
# 默认:     0 - (禁用)
# 1 - (启用)

PlayerStart.MapsExplored = 0

#
###################################################################################################

###################################################################################################
# 账号(ACCOUNT)
#
#    Trial.LevelCap
# 描述: 试玩账号可达到的最高等级。到达后经验获取停止。
# 默认:     20
# 0  - (禁用,无上限)

Trial.LevelCap = 20

#
#    Trial.MoneyCap
# 描述: 试玩账号可持有的金钱上限(铜币)。
# 默认:     100000 - (10 金币)
# 0      - (禁用,无上限)

Trial.MoneyCap = 100000

#
#    Trial.TradeSkillCap
# 描述: 试玩账号专业技巧可达到的最大值。
# 默认:     100
# 0   - (禁用,无上限)

Trial.TradeSkillCap = 100

#
#    Trial.Restriction.Chat
# 描述: 限制试玩账号使用密语/频道/公会聊天。
# 仅当试玩玩家在收件人好友列表中时才允许密语
# 或试玩账号先被发消息时。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Chat = 1

#
#    Trial.Restriction.Mail
# 描述: 限制试玩账号发送邮件。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Mail = 1

#
#    Trial.Restriction.Trade
# 描述: 限制试玩账号发起或作为游戏内交易的对象。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Trade = 1

#
#    Trial.Restriction.Auction
# 描述: 限制试玩账号在拍卖行挂拍、竞拍或取消拍卖。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Auction = 1

#
#    Trial.Restriction.Party
# 描述: 限制试玩账号邀请玩家入队,以及接受
# 已有成员等级超过 Trial.LevelCap 的组队邀请。
# Trial.LevelCap 为 0 时跳过加入检查。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Party = 1

#
#    Trial.Restriction.Guild
# 描述: 限制试玩账号加入公会(接受邀请)以及
# 创建契约(购买、签名或上交公会契约)。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Guild = 1

#
#    Trial.Restriction.Queue
# 描述: 强制试玩账号走世界会话排队,即使其账号
# 权限标志本可授予跳过排队优先级。RBAC_PERM_SKIP_QUEUE
# 权限与最近断线宽限仍然生效。
# 默认:     1 - (启用)
# 0 - (禁用)

Trial.Restriction.Queue = 1

#
###################################################################################################

###################################################################################################
# 角色数据库(CHARACTER DATABASE)
#
#    PlayerSaveInterval
# 描述: 玩家存档间隔(毫秒)。
# 默认:     900000 - (15 分钟)

PlayerSaveInterval = 900000

#
#    PlayerSave.Stats.MinLevel
# 描述: 角色属性存入数据库(供外部使用)的最低等级。
# 默认:     0  - (禁用,不保存角色属性)
# 1+ - (启用,超过该等级才保存角色属性)

PlayerSave.Stats.MinLevel = 0

#
#    PlayerSave.Stats.SaveOnlyOnLogout
# 描述: 仅在登出时保存玩家属性。
# 默认:     1 - (启用,仅在登出时保存)
# 0 - (禁用,随每次玩家保存一起保存)

PlayerSave.Stats.SaveOnlyOnLogout = 1

#
#    PlayerSave.AdditionalSaves
# 描述: 若干秒后保存到数据库的玩家数据掩码,
# 重要变更,而不必等待下一次定期保存
# (PlayerSaveInterval)。减少服务器崩溃时的进度损失。
# 组合这些值可启用多个触发条件。
# 取值:      1 - 背包与金钱(拾取精良及以上品质物品后)
# 2 - 任务状态(任务状态变更后)
# 4 - 成就(完成成就后)
# 默认:     0 - (禁用)
# 7 - (以上全部)

PlayerSave.AdditionalSaves = 0

#
#    CleanCharacterDB
# 描述: 清理数据库中已弃用的成就、技能、法术与天赋。
# 默认:     0 - (禁用)
# 1 - (启用)

CleanCharacterDB = 0

#
#    PersistentCharacterCleanFlags
# 描述: 决定清理后仍保持设置的角色数据清理标志。
# 这是一个位掩码值,可使用以下值之一:
#
# CLEANING_FLAG_ACHIEVEMENT_PROGRESS  = 0x1 (成就进度)
# CLEANING_FLAG_SKILLS                = 0x2 (技能)
# CLEANING_FLAG_SPELLS                = 0x4 (法术)
# CLEANING_FLAG_TALENTS               = 0x8 (天赋)
# CLEANING_FLAG_QUESTSTATUS           = 0x10 (任务状态)
# 注意:        使用此功能前请备份数据库。
# 示例:     14 - (CLEANING_FLAG_SKILLS + CLEANING_FLAG_SPELLS + CLEANING_FLAG_TALENTS
# 2+4+8 => 14。这将清理技能、天赋,法术也将
# 下次清理后仍保持启用)
# 默认:     0  - (下次清理后所有清理方式都会被禁用)

PersistentCharacterCleanFlags = 0

#
#    ValidateSkillLearnedBySpells
# 描述: 启用后,玩家将失去与其种族/职业不合法的法术。
# 默认:     1 - (启用,强制法术合法)
# 0 - (禁用,允许非法法术)
# 注意:        禁用此选项后,若角色学习了需要修改 DBC 的法术,该角色可能无法保存到数据库
# 禁用风险自负

ValidateSkillLearnedBySpells = 1

#
###################################################################################################

###################################################################################################
# 角色删除(CHARACTER DELETE)
#
#    CharDelete.Method
# 描述: 角色删除行为。
# 默认:     0 - (将角色从数据库中彻底删除)
# 1 - (将角色与账号解绑并释放名字,显示为
# 在游戏内删除)

CharDelete.Method = 0

#
#    CharDelete.MinLevel
# 描述: 启用解绑方式时所需的等级。
# 默认:     0  - (所有等级用同一方式)
# 1+ - (仅达到该等级的角色使用解绑方式)

CharDelete.MinLevel = 0

#
#    CharDelete.KeepDays
# 描述: 解绑角色从数据库移除前的天数。
# 默认:     30 - (启用)
# 0  - (禁用,不删除任何角色)

CharDelete.KeepDays = 30

#
###################################################################################################

###################################################################################################
# 角色创建(CHARACTER CREATION)
#
#    MinPlayerName
# 描述: 玩家名称的最小长度。
# 范围:       1-12
# 默认:     2

MinPlayerName = 2

#
#    MinPetName
# 描述: 宠物名称的最小长度。
# 范围:       1-12
# 默认:     2

MinPetName = 2

#
#    DeclinedNames
# 描述: 允许俄语客户端设置并使用名字变格。
# 默认:     0 - (禁用,但设置了俄语服务器区域时除外)
# 1 - (启用)

DeclinedNames = 0

#
#    StrictNames.Reserved
# 描述: 使用 DBC 中的保留词过滤。
# 防止玩家、宠物与公会契约名包含保留名。
# 默认:     1 - 启用
# 0 - 禁用

StrictNames.Reserved = 1

#
#    StrictNames.Profanity
# 描述: 使用 DBC 中的敏感词过滤。
# 防止玩家、宠物与公会契约名包含脏话。
# 默认:     1 - 启用
# 0 - 禁用

StrictNames.Profanity = 1

#
#    StrictPlayerNames
# 描述: 限制玩家名称只能使用对应语言的字符集。防止角色
# 角色创建,并在使用不允许符号时强制要求改名
# 默认:     0 - (禁用,有限的按时区客户端检查)
# 1 - (启用,严格基础拉丁字符)
# 2 - (启用,严格按服务器区域字符,见 RealmZone 设置,
# 注意:        客户端需安装支持
# 该字符集。非官方本地化需要自定义字体,
# 需放在 clientdir/Fonts。)
# 3 - (启用,基础拉丁字符 + 服务器时区字符)

StrictPlayerNames = 0

#
#    StrictPetNames
# 描述: 限制宠物名称只能使用对应语言的字符集。
# 使用不允许的符号时禁止宠物命名。
# 默认:     0 - (禁用,有限的按时区客户端检查)
# 1 - (启用,严格基础拉丁字符)
# 2 - (启用,严格按服务器区域字符,见 RealmZone 设置,
# 注意:        客户端需安装支持
# 该字符集。非官方本地化需要自定义字体,
# 需放在 clientdir/Fonts。)
# 3 - (启用,基础拉丁字符 + 服务器时区字符)

StrictPetNames = 0

#
#    CharacterCreating.Disabled
# 描述: 按阵营禁止玩家创建角色。
# 默认:     0 - (启用,允许所有阵营)
# 1 - (禁用,联盟)
# 2 - (禁用,部落)
# 3 - (禁用,双方阵营)

CharacterCreating.Disabled = 0

#
#    CharacterCreating.Disabled.RaceMask
# 描述: 禁止玩家创建的种族掩码。
# 示例:     1536 - (1024 + 512,禁用血精灵与德莱尼种族)
# 默认:     0    - (启用,允许所有种族)
# 1    - (禁用,人类)
# 2    - (禁用,兽人)
# 4    - (禁用,矮人)
# 8    - (禁用,暗夜精灵)
# 16   - (禁用,亡灵)
# 32   - (禁用,牛头人)
# 64   - (禁用,侏儒)
# 128  - (禁用,巨魔)
# 512  - (禁用,血精灵)
# 1024 - (禁用,德莱尼)

CharacterCreating.Disabled.RaceMask = 0

#
#    CharacterCreating.Disabled.ClassMask
# 描述: 禁止玩家创建的职业掩码。
# 示例:     288 - (32 + 256,禁用死亡骑士与术士职业)
# 默认:     0    - (启用,允许所有职业)
# 1    - (禁用,战士)
# 2    - (禁用,圣骑士)
# 4    - (禁用,猎人)
# 8    - (禁用,盗贼)
# 16   - (禁用,牧师)
# 32   - (禁用,死亡骑士)
# 64   - (禁用,萨满)
# 128  - (禁用,法师)
# 256  - (禁用,术士)
# 1024 - (禁用,德鲁伊)

CharacterCreating.Disabled.ClassMask = 0

#
#    CharactersPerAccount
# 描述: 限制本账号列表下所有服务器的角色总数。
# 重要:   数值必须 >= CharactersPerRealm
# 默认:     50

CharactersPerAccount = 50

#
#    CharactersPerRealm
# 描述: 限制本服务器每账号的角色数量。
# 范围:       1-10
# 默认:     10 - (客户端限制)

CharactersPerRealm = 10

#
#    HeroicCharactersPerRealm
# 描述: 限制本服务器每账号的英雄职业角色数量。
# 范围:       1-10
# 默认:     1

HeroicCharactersPerRealm = 1

#
#    CharacterCreating.MinLevelForHeroicCharacter
# 描述: 仅当账号上另有
# 特定等级的角色(GM 账号忽略)
# 默认:     55 - (启用,需要账号上另有 55 级角色)
# 0  - (禁用)
# 1  - (启用,需要账号上另有 1 级角色)

CharacterCreating.MinLevelForHeroicCharacter = 55

#
#    StartPlayerLevel
# 描述: 角色创建后的初始等级。
# 范围:       1-MaxPlayerLevel
# 默认:     1

StartPlayerLevel = 1

#
#    StartHeroicPlayerLevel
# 描述: 英雄职业角色创建后的初始等级。
# 范围:       1-MaxPlayerLevel
# 默认:     55

StartHeroicPlayerLevel = 55

#
#    SkipCinematics
# 描述: 禁用角色创建后首次登录的开场动画。
# 使用自定义出生点坐标时避免开场动画出错。
# 默认:     0 - (每个新角色都播放开场动画)
# 1 - (仅对所选种族的第一个角色播放开场动画)
# 2 - (对所有职业禁用开场动画)

SkipCinematics = 0

#
#    StartPlayerMoney
# 描述: 角色创建后拥有的金钱数额(铜币)。
# 默认:     0
# 100 - (1 银币)

StartPlayerMoney = 0

#
#    StartHeroicPlayerMoney
# 描述: 英雄职业角色创建后拥有的金钱数额(铜币)。
# 默认:     2000
# 2000 - (20 银币)

StartHeroicPlayerMoney = 2000

#
#    PlayerStart.String
# 描述: 新建角色首次登录时显示的文本。
# 默认:     "" - (禁用)

PlayerStart.String = ""

