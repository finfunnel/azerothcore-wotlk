################################################
# AzerothCore 世界服务器配置文件                       #
################################################
[worldserver]

###################################################################################################
# 章节索引(SECTION INDEX)
#
# 服务器系统设置(SERVER SYSTEM SETTINGS)
# 数据库与连接(DATABASE & CONNECTIONS)
# 目录(DIRECTORIES)
# 控制台(CONSOLE)
# 自动更新(AUTOUPDATER)
# 网络(NETWORK)
# 远程访问(REMOTE ACCESS)
# 加密(CRYPTOGRAPHY)
# 性能(PERFORMANCE)
# 日志(LOGGING)
# 指标统计(METRIC)
# 服务器(SERVER)
# 封包伪造防护设置(PACKET SPOOF PROTECTION)
# 反作弊(WARDEN)
# 自动广播(AUTO BROADCAST)
# 可见性与距离(VISIBILITY AND DISTANCES)
# 地图(MAPS)
# 天气(WEATHER)
# 工单(TICKETS)
# 命令(COMMAND)
#
# 游戏设置(GAME SETTINGS)
# 游戏管理员(GAME MASTER)
# 作弊(CHEAT)
# 账号(ACCOUNT)
# 角色数据库(CHARACTER DATABASE)
# 角色删除(CHARACTER DELETE)
# 角色创建(CHARACTER CREATION)
# 角色(CHARACTER)
# 成就(ACHIEVEMENT)
# 技能(SKILL)
# 属性(STATS)
# 声望(REPUTATION)
# 经验(EXPERIENCE)
# 货币(CURRENCY)
# 耐久度(DURABILITY)
# 死亡(DEATH)
# 宠物(PET)
# 物品删除(ITEM DELETE)
# 物品(ITEM)
# 任务(QUEST)
# 生物(CREATURE)
# 商人(VENDOR)
# 队伍(GROUP)
# 副本(INSTANCE)
# 地下城与战场查找器(DUNGEON & BG FINDER)
# 公会契约(CHARTER)
# 公会(GUILD)
# 自由 PVP(FFAPVP)
# 野外 PVP(OUTDOORPVP)
# 冬拥湖(WINTERGRASP)
# 战场(BATTLEGROUND)
# 竞技场(ARENA)
# 邮件(MAIL)
# 交通工具(TRANSPORT)
# 聊天频道(CHAT CHANNEL)
# 阵营交互(FACTION INTERACTION)
# 好友招募(RECRUIT A FRIEND)
# 日历(CALENDAR)
# 游戏事件(GAME EVENT)
# 拍卖行(AUCTION HOUSE)
# 角色导出(PLAYER DUMP)
# 自定义(CUSTOM)
# 调试(DEBUG)
# 动态重生设置(DYNAMIC RESPAWN)
#
# 集群设置(CLUSTER SETTINGS)
#
###################################################################################################

###################################################################################################
#                                                                                                 #
# 服务器系统设置 开始                                                                                      #
#                                                                                                 #
###################################################################################################

###################################################################################################
# 数据库与连接(DATABASE & CONNECTIONS)
#
#    RealmID
# 描述: 使用此配置的服务器(领域) ID。
# 重要:   RealmID 必须与 auth 数据库 realmlist 中的一致。
# 默认:     1

RealmID = 1

#
#    WorldServerPort
# 描述: 世界服务器的 TCP 端口。
# 默认:     8085

WorldServerPort = 8085

#
#    BindIP
# 描述: 将世界服务器绑定到 IP/主机名
# 默认:     "0.0.0.0" - (绑定到系统所有 IP)

BindIP = "0.0.0.0"

#
#    LoginDatabaseInfo
#    WorldDatabaseInfo
#    CharacterDatabaseInfo
# 描述: 世界服务器的数据库连接设置。
# 示例:     "主机名;端口;用户名;密码;数据库"
# ".;某个数字;用户名;密码;数据库"
# (在 Windows 上使用命名管道,在 my.ini 的 [mysqld] 段加 "enable-named-pipe")
# ".;/unix套接字路径;用户名;密码;数据库"
# (在 Unix/Linux 上使用 Unix 套接字)
# 默认:     "127.0.0.1;3306;acore;acore;acore_auth"       - (LoginDatabaseInfo)
# "127.0.0.1;3306;acore;acore;acore_world"      - (WorldDatabaseInfo)
# "127.0.0.1;3306;acore;acore;acore_characters"       - (CharacterDatabaseInfo)

LoginDatabaseInfo     = "127.0.0.1;3306;acore;acore;acore_auth"
WorldDatabaseInfo     = "127.0.0.1;3306;acore;acore;acore_world"
CharacterDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_characters"

#
#    LoginDatabase.WorkerThreads
#    WorldDatabase.WorkerThreads
#    CharacterDatabase.WorkerThreads
# 描述: 为处理异步(延迟) MySQL 操作创建的工作线程数
# 语句。每个工作线程都与
# MySQL 服务器的连接与线程一一对应。
# 默认:     1 - (LoginDatabase.WorkerThreads)
# 1 - (WorldDatabase.WorkerThreads)
# 1 - (CharacterDatabase.WorkerThreads)

LoginDatabase.WorkerThreads     = 1
WorldDatabase.WorkerThreads     = 1
CharacterDatabase.WorkerThreads = 1

#
#    LoginDatabase.SynchThreads
#    WorldDatabase.SynchThreads
#    CharacterDatabase.SynchThreads
# 描述: 所创建的用于处理同步操作的 MySQL 连接数。
# 默认:     1 - (LoginDatabase.SynchThreads)
# 1 - (WorldDatabase.SynchThreads)
# 1 - (CharacterDatabase.SynchThreads)

LoginDatabase.SynchThreads     = 1
WorldDatabase.SynchThreads     = 1
CharacterDatabase.SynchThreads = 1

#
#    MaxPingTime
# 描述: 数据库 ping 的间隔(分钟)。
# 默认:     30

MaxPingTime = 30

#
#    Database.Reconnect.Seconds
#    Database.Reconnect.Attempts
# 描述: 每次重连尝试之间的秒数
# 以及总共尝试多少次
# 默认:     每 15 秒尝试 20 次
#

Database.Reconnect.Seconds = 15
Database.Reconnect.Attempts = 20

#
###################################################################################################

###################################################################################################
# 目录(DIRECTORIES)
#
#    DataDir
# 描述: 数据目录设置。
# 重要:   DataDir 需加引号,字符串可能含空格。
# 示例:     "@prefix@\home\你的用户名\azerothcore\data"
# 默认:     "."

DataDir = "."

#
#    LogsDir
# 描述: 日志目录设置。
# 重要:   LogsDir 需加引号,字符串可能含空格。
# 日志目录必须存在,否则将禁用日志文件创建。
# 示例:     "/home/你的用户名/azerothcore/logs"
# 默认:     "" - (日志文件将存放在当前路径)

LogsDir = ""

#
#    TempDir
# 描述: 临时目录设置。
# 重要:   TempDir 需加引号,字符串可能含空格。
# TempDir 目录必须存在,否则服务器无法正常工作
# 示例:     "/home/你的用户名/azerothcore/temp"
# 默认:     "" - (临时文件将存放在当前路径)

TempDir = ""

#
#    CMakeCommand
# 描述: CMake 可执行文件路径。
# 若路径留空,将使用内置的 CMAKE_COMMAND。
# 示例:     "C:/Program Files/CMake/bin/cmake.exe"
# "/usr/bin/cmake"
# 默认:     ""

CMakeCommand = ""

#
#    BuildDirectory
# 描述: 构建目录路径。
# 若路径留空,将使用内置的 CMAKE_BINARY_DIR。
# 示例:     "../AzerothCore"
# 默认:     ""

BuildDirectory = ""

#
#    SourceDirectory
# 描述: AzerothCore 源码目录路径。
# 若路径留空,将使用内置的 CMAKE_SOURCE_DIR。
# 示例:     "../azerothcore-wotlk"
# 默认:     ""

SourceDirectory = ""

#
#    MySQLExecutable
# 描述: MySQL 命令行可执行文件路径。
# 若路径留空,将使用 cmake 内置路径。
# 示例:     "C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe"
# "mysql.exe"
# "/usr/bin/mysql"
# 默认:     ""

MySQLExecutable = ""

#
#    PidFile
# 描述: 世界守护进程的 PID 文件。
# 示例:     "./world.pid" - (启用)
# 默认:     ""            - (禁用)

PidFile = ""

#
###################################################################################################

###################################################################################################
# 控制台(CONSOLE)
#
#    Console.Enable
# 描述: 启用控制台。
# 默认:     1 - (启用)
# 0 - (禁用)

Console.Enable = 1

#
#    BeepAtStart
# 描述: 世界服务器启动完成时蜂鸣提示(Unix/Linux 系统)。
# 默认:     1 - (启用)
# 0 - (禁用)

BeepAtStart = 1

#
#    FlashAtStart
# 描述: 世界服务器启动完成时任务栏闪烁。(仅限 Windows)
# 默认:     1 - (启用)
# 0 - (禁用)

FlashAtStart = 1

#
###################################################################################################

###################################################################################################
# 自动更新(AUTOUPDATER)
#
#    Updates.EnableDatabases
# 描述: 描述哪些数据库需要更新的掩码。
# 注意:        可用标志如下
# DATABASE_LOGIN     = 1, 认证数据库
# DATABASE_CHARACTER = 2, 角色数据库
# DATABASE_WORLD     = 4, 世界数据库
# 默认:     7 - (全部启用)
# 4 - (仅世界生效)
# 0 - (全部禁用)

Updates.EnableDatabases = 7

#
#    Updates.AutoSetup
# 描述: 自动填充空数据库。
# 默认:     1 - (启用)
# 0 - (禁用)

Updates.AutoSetup   = 1

#
#    Updates.Redundancy
# 描述: 通过哈希执行数据冗余校验
# 以检测 SQL 更新的变更并重新应用。
# 默认:     1 - (启用)
# 0 - (禁用)

Updates.Redundancy  = 1

#
#    Updates.ArchivedRedundancy
# 描述: 校验已归档更新的哈希(会拖慢启动)。
# 默认:     0 - (禁用)
# 1 - (启用)

Updates.ArchivedRedundancy = 0

#
#    Updates.AllowRehash
# 描述: 若留空,则把当前文件哈希插入数据库。
# 适用于想将某文件标记为已应用但不知道其哈希的情况。
# 默认:     1 - (启用)
# 0 - (禁用)

Updates.AllowRehash = 1

#
#    Updates.CleanDeadRefMaxCount
# 描述: 清理因更新被一步完成"删除或重命名并修改"而产生的死链/孤立引用。
# 仅当缺失更新的数量小于等于 Updates.CleanDeadRefMaxCount 值时才开始清理。
# 这样可防止因源码目录状态错误(可能分支或版本不对)而清空更新历史。
# 若想知道数据库是否可能处于"脏状态",可禁用此项。
# 默认:     3 - (启用)
# 0 - (禁用)
# -1 - (启用 - 无限制)

Updates.CleanDeadRefMaxCount = 3

#
#    Updates.ExceptionShutdownDelay
# 描述: 发生致命异常(如 SQL 更新失败)后等待关停的毫秒数。
# 默认:     10000 - 10 秒
# 0     - 禁用(立即关闭)

Updates.ExceptionShutdownDelay = 10000

#
###################################################################################################

###################################################################################################
# 网络(NETWORK)
#
#    Network.Threads
# 描述: 网络线程数。
# 默认:     1 - (推荐每 1000 个连接 1 线程)

Network.Threads = 1

#
#    Network.OutKBuff
# 描述: 用于内核输出缓冲区的内存字节数(参见 SO_SNDBUF
# 套接字选项,参见 TCP 手册)。
# 默认:     -1 - (使用系统默认设置)

Network.OutKBuff = -1

#
#    Network.OutUBuff
# 描述: 每个连接在用户空间初始预留的
# 连接的输出缓冲。
# 默认:     4096

Network.OutUBuff = 4096

#
# Network.TcpNoDelay:
# 描述: TCP Nagle 算法设置。
# 默认:    0 - (启用,流量更少,延迟更高)
# 1 - (禁用,流量更大,延迟更低,TCP_NO_DELAY)

Network.TcpNodelay = 1

#
#    Network.EnableProxyProtocol
# 描述: 启用 Proxy Protocol v2。当你的服务器位于代理之后,
# 负载均衡器或类似组件时,需要在本服务器与代理/
# 负载均衡器都启用 Proxy Protocol v2,以便追踪玩家真实 IP。
# 示例:     1 - (启用)
# 默认:     0 - (禁用)

Network.EnableProxyProtocol = 0

#
#    Network.UseSocketActivation
# 描述: [仅限 Linux] 为 worldserver 启用 systemd socket 激活支持。
# 启用且进程由 systemd 套接字激活启动时,
# 服务器将使用 systemd 传入的套接字,而非
# 创建并绑定自己的监听套接字。默认禁用。
# 启用后,关机时服务器(领域)不会被自动置为离线。
# 示例:     1 - (启用)
# 默认:     0 - (禁用)

Network.UseSocketActivation = 0

#
###################################################################################################

###################################################################################################
# 远程访问(REMOTE ACCESS)
#
#    Ra.Enable
# 描述: 启用远程控制台(telnet)。
# 默认:     0 - (禁用)
# 1 - (启用)

Ra.Enable = 0

#
#    Ra.IP
# 描述: 将远程访问绑定到 IP/主机名。
# 默认:     "0.0.0.0" - (绑定到系统所有 IP)

Ra.IP = "0.0.0.0"

#
#    Ra.Port
# 描述: 远程控制台的 TCP 端口。
# 默认:     3443

Ra.Port = 3443

#
#    Ra.MinLevel
# 描述: 使用远程控制台所需的权限等级。
# 默认:     3

Ra.MinLevel = 3

#
#    SOAP.Enable
# 描述: 启用 SOAP 服务
# 默认:     0 - (禁用)
# 1 - (启用)

SOAP.Enabled = 0

#
#    SOAP.IP
# 描述: 将 SOAP 服务绑定到 IP/主机名
# 默认:     "127.0.0.1" - (绑定到本机)

SOAP.IP = "127.0.0.1"

#
#    SOAP.Port
# 描述: SOAP 服务的 TCP 端口。
# 默认:     7878

SOAP.Port = 7878

#
###################################################################################################

###################################################################################################
# 加密(CRYPTOGRAPHY)
#
#    TOTPMasterSecret
# 描述: authserver 用于解密数据库中 TOTP 密钥的主密钥。
# 仅当打算使用游戏内 2FA
# 管理命令(.account 2fa)时才需要在此设置,否则可留空。
# 若此值与 authserver 设置不一致,服务器会自动检测,
# 此时所有依赖该密钥的命令都将被禁用。
# 默认:     <留空>
#

TOTPMasterSecret =

#
###################################################################################################

###################################################################################################
# 性能(PERFORMANCE)
#
#    ThreadPool
# 描述: 全局线程池使用的线程数
# 线程池目前用于:
# - 信号处理
# - 远程访问
# - 数据库保活 ping
# - 内核死锁检查
# - 世界套接字网络
# 默认:     2

ThreadPool = 2

#
#    UseProcessors
# 描述: Windows 与 Linux 多处理器系统的处理器掩码。
# 示例:     对于 3 CPU 的电脑:
# 1  - 仅第 1 个 CPU
# 2  - 仅第 2 个 CPU
# 4  - 仅第 3 个 CPU
# 6  - 第 2+3 个 CPU,因为 "2 | 4" -> 6
# 默认:     0  - (由操作系统决定)
# 1+ - (所选处理器的位掩码值)

UseProcessors = 0

#
#    ProcessPriority
# 描述: Windows 系统的进程优先级设置。
# 默认:     1 - (高)
# 0 - (普通)

ProcessPriority = 1

#
#    Compression
# 描述: 客户端更新包的压缩等级
# 范围:       1-9
# 默认:     1 - (速度)
# 9 - (最高压缩)

Compression = 1

#
###################################################################################################

###################################################################################################
# 日志(LOGGING)
#
#    PacketLogFile
# 描述: 世界服务器的二进制封包日志文件。
# 文件扩展名必须为 .pkt 才能用 WowPacketParser 解析。
# 示例:     "World.pkt" - (启用)
# 默认:     ""          - (禁用)

PacketLogFile = ""

#
#    LogDB.Opt.ClearInterval
# 描述: WUPDATE_CLEANDB 定时器清理 `logs` 表的时间(分钟),
# 旧条目。
# 默认:     10 - (10 分钟)
# 1+

LogDB.Opt.ClearInterval = 10

#
#    LogDB.Opt.ClearTime
# 描述: `logs` 表旧记录保留的秒数。
# 默认:     1209600 - (启用,14 天)
# 0       - (禁用,不清除条目)

LogDB.Opt.ClearTime = 1209600

#
#    RecordUpdateTimeDiffInterval
# 描述: 更新耗时差写入日志文件的间隔(毫秒)。
# 更新 diff 可作为性能指标。Diff < 300: 良好;
# 性能一般;Diff > 600 性能差,可能因 CPU 占用过高。
# 默认:     300000 - (启用,5 分钟)
# 0      - (禁用)

RecordUpdateTimeDiffInterval = 300000

#
#     MinRecordUpdateTimeDiff
# 描述: 只记录大于此值的更新耗时差。
# 默认:     100

MinRecordUpdateTimeDiff = 100

#
#    IPLocationFile
# 描述: IP2Location 数据库 CSV 文件路径。
# 示例:     "C:/acore/IP2LOCATION-LITE-DB1.CSV"
# "/home/acore/IP2LOCATION-LITE-DB1.CSV"
# 默认:     "" - (禁用)

IPLocationFile = ""

#
#    AllowLoggingIPAddressesInDatabase
# 描述: 指定是否可将 IP 地址记录到数据库
# 默认:     1 - (启用)
# 0 - (禁用)

AllowLoggingIPAddressesInDatabase = 1

#
#    Allow.IP.Based.Action.Logging
# 描述: 按当前会话 IP 记录操作日志,如账号登录与登出等。
# 默认:     0 - (禁用)
# 1 - (启用)

Allow.IP.Based.Action.Logging = 0

#
#    LogSpamReports
# 描述: 允许把玩家在聊天、邮件或日历中的垃圾信息举报记录到数据库。
# 默认:     1 - (启用)
# 0 - (禁用)

LogSpamReports = 1

#
#    ChatLog.Enable
# 描述: 启用/禁用聊天日志(chat_log.cpp)。
# 默认:     0 - (禁用)
# 1 - (启用)

ChatLog.Enable = 0

#
# Appender 配置项: 给定 appender "名称"
#    Appender.name
# 描述: 定义"记录到哪里"。
# 格式:      Type,LogLevel,Flags,optional1,optional2,optional3
# Type:        0  - (无)
# 1  - (控制台)
# 2  - (文件)
# 3  - (数据库)
# LogLevel:    0  - (禁用)
# 1  - (致命 Fatal)
# 2  - (错误 Error)
# 3  - (警告 Warning)
# 4  - (信息 Info)
# 5  - (调试 Debug)
# 6  - (追踪 Trace)
# Flags:       0  - 无
# 1  - 在文本前加时间戳
# 2  - 在文本前加日志级别
# 4  - 在文本前加日志过滤类型
# 8  - 在日志文件名后追加时间戳,格式: YYYY-MM-DD_HH-MM-SS
# (仅当 Type = 2 时使用)
# 16 - 覆盖前备份现有文件
# (仅当 Mode = w 时使用)
# Colors:      (Type = Console 时作为 optional1 读取)
# 格式:      "致命 错误 警告 信息 调试 追踪"
# 0  - 黑色
# 1  - 红色
# 2  - 绿色
# 3  - 棕色
# 4  - 蓝色
# 5  - 洋红
# 6  - 青色
# 7  - 灰色
# 8  - 黄色
# 9  - 浅红
# 10 - 浅绿
# 11 - 浅蓝
# 12 - 浅洋红
# 13 - 浅青
# 14 - 白色
# 示例:     "1 9 3 6 5 8"
# File:        文件名(Type = File 时作为 optional1 读取)
# 允许使用一个 "%s" 生成动态文件
# Mode:        文件打开模式(type = File 时作为 optional2 读取)
# a - (追加)
# w - (覆盖)
# MaxFileSize: 日志文件创建新文件前的最大尺寸
# (Type = File 时作为 optional3 读取)
# 大小以字节计,使用 64 位无符号整数表示。
# 最大值 4294967295 (4 GB)。留空表示不限制。
# 注意:        对动态文件名无效。
# 示例:     536870912 (512 MB)

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.Server=2,5,0,Server.log,w
Appender.Playerbots=2,5,0,Playerbots.log,w
# Appender.GM=2,5,15,gm_%s.log
Appender.Errors=2,2,0,Errors.log,w
# Appender.DB=3,5,0
# Appender.Dev=2,5,0,Dev.log,a

# Logger 配置项: 给定 logger "名称"
#    Logger.name
# 描述:  定义"记录什么"
# 格式:       LogLevel,AppenderList
# LogLevel:     0 - (禁用)
# 1 - (致命 Fatal)
# 2 - (错误 Error)
# 3 - (警告 Warning)
# 4 - (信息 Info)
# 5 - (调试 Debug)
# 6 - (追踪 Trace)
# AppenderList: 与该 logger 关联的 appender 列表
# (使用空格作为分隔符)。
#

Logger.root=2,Console Server
# Logger.metric=2,Console Server
# Logger.commands.gm=4,Console GM
Logger.diff=3,Console Server
Logger.mmaps=4,Server
Logger.scripts.hotswap=4,Console Server
Logger.server=4,Console Server
Logger.sql.sql=2,Console Errors
Logger.sql.updates=4,Console Server Errors
Logger.sql=4,Console Server
Logger.time.update=4,Console Server
Logger.module=4,Console Server
Logger.spells.scripts=2,Console Errors
Logger.playerbots=5,Console Playerbots
