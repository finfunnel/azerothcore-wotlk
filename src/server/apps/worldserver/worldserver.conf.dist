# |  0 |  灰色 |            劣质 |
# |  1 |  白色 |            普通 |
# |  2 |  绿色 |            优秀 |
# |  3 |  蓝色 |            精良 |
# |  4 |  紫色 |            史诗 |
# |  5 |  橙色 |            传说 |
# |  6 |  红色 |            神器 |
# |  7 |  金色 |          绑定账号 |
# 默认:     3

ItemDelete.Quality = 3

#
#    ItemDelete.ItemLevel
# 描述: 装备等级大于等于 ItemDelete.ItemLevel 的物品存入数据库
# 默认:     80

ItemDelete.ItemLevel = 80

#
#    ItemDelete.KeepDays
# 描述: 时间(天)
# 默认:     0  - (禁用,不删除任何记录)
# 30 - (启用)

ItemDelete.KeepDays = 0

