# 默认:     1 - (Rate.Health)
# 1 - (Rate.Mana)
# 1 - (Rate.Rage.Income)
# 1 - (Rate.Rage.Loss)
# 1 - (Rate.RunicPower.Income)
# 1 - (Rate.RunicPower.Loss)
# 1 - (Rate.Focus)
# 1 - (Rate.Energy)

Rate.Health            = 1
Rate.Mana              = 1
Rate.Rage.Income       = 1
Rate.Rage.Loss         = 1
Rate.RunicPower.Income = 1
Rate.RunicPower.Loss   = 1
Rate.Focus             = 1
Rate.Energy            = 1

#
#    Rate.Rest.InGame
#    Rate.Rest.Offline.InTavernOrCity
#    Rate.Rest.Offline.InWilderness
#    Rate.Rest.MaxBonus
# 描述: 休息值增长倍率。
# 默认:     1   - (Rate.Rest.InGame)
# 1   - (Rate.Rest.Offline.InTavernOrCity)
# 1   - (Rate.Rest.Offline.InWilderness)
# 1.5 - (Rate.Rest.MaxBonus)

Rate.Rest.InGame                 = 1
Rate.Rest.Offline.InTavernOrCity = 1
Rate.Rest.Offline.InWilderness   = 1
Rate.Rest.MaxBonus               = 1.5

#
#    Rate.MissChanceMultiplier.Creature
#    Rate.MissChanceMultiplier.Player
#    Rate.MissChanceMultiplier.OnlyAffectsPlayer
# 描述: 当目标比玩家高 3 级或以上时,
# 命中率由公式决定: 94 - (levelDiff - 2) * Rate.MissChanceMultiplier
# Rate.MissChanceMultiplier 常数越大,未命中概率越高。
# 注意:        玩家与目标等级差小于 3 时不受影响,
# 将改用此(线性)公式计算命中率: 96 - levelDiff。
# 若只想影响玩家的未命中率,可将 Rate.MissChanceMultiplier.OnlyAffectsPlayer 设为 1
# 仅影响玩家施法者。这样不会影响生物的未命中概率。
# 示例:     若想让概率保持线性增长,设为 1。
# 默认:     Rate.MissChanceMultiplier.TargetCreature = 11
# Rate.MissChanceMultiplier.TargetPlayer = 7
# Rate.MissChanceMultiplier.OnlyAffectsPlayer = 0

Rate.MissChanceMultiplier.TargetCreature = 11
Rate.MissChanceMultiplier.TargetPlayer = 7
Rate.MissChanceMultiplier.OnlyAffectsPlayer = 0

#
#    LevelReq.Trade
# 描述: 角色发起交易的等级要求。
# 默认:     1

LevelReq.Trade = 1

